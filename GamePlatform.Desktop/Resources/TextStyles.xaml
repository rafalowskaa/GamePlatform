<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ======= PĘDZLE TEKSTU ======= -->
    <SolidColorBrush x:Key="TextLightBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="TextDarkBrush"  Color="#FF000000"/>

    <!-- ======= STYLE DOMYŚLNE (biała czcionka) ======= -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextLightBrush}"/>
    </Style>

    <!-- Kopie dla typów dziedziczących po ContentControl -->
    <Style TargetType="Label"   BasedOn="{StaticResource {x:Type TextBlock}}"/>
    <Style TargetType="Button"  BasedOn="{StaticResource {x:Type TextBlock}}"/>
    <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type TextBlock}}"/>
    <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type TextBlock}}"/>

    <!-- ======= POMOCNICZY STYL DO JASNYCH KONTENERÓW ======= -->
    <!--   Użycie: <StackPanel Background="White"> 
                     <TextBlock Style="{StaticResource TextOnLight}" …/> </StackPanel>   -->
    <Style x:Key="TextOnLight" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextDarkBrush}"/>
    </Style>
</ResourceDictionary>
