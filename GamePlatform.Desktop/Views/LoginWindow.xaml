<Window x:Class="GamePlatform.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:conv="clr-namespace:GamePlatform.Desktop.Converters"
        Title="Logowanie"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource MaterialDesignWindow}">

    <Window.Resources>
        <conv:BoolToVisConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="24" Width="300">

        <!-- ===== LOGOWANIE ===== -->
        <StackPanel Visibility="{Binding IsRegistering,
                                         Converter={StaticResource BoolToVis},
                                         ConverterParameter=Invert}">

            <TextBox Text="{Binding Login}"
                     md:HintAssist.Hint="Login lub e-mail"/>

            <PasswordBox Margin="0 8 0 0"
                         md:HintAssist.Hint="Hasło"
                         PasswordChanged="PwdChanged"/>

            <CheckBox Content="Zapamiętaj mnie"
                      Margin="0 8 0 0"
                      IsChecked="{Binding RememberMe}"/>

            <TextBlock Text="{Binding Error}" Foreground="Red" TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0 12 0 0">
                <Button Content="Rejestracja" Click="ShowRegisterClick"/>
                <Button Content="Zaloguj"
                        Margin="12 0 0 0"
                        IsDefault="True"
                        Command="{Binding SubmitLoginCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
            </StackPanel>

            <TextBlock Margin="0 8 0 0" HorizontalAlignment="Right">
                <Hyperlink Click="ForgotPwdClick">Nie pamiętasz hasła?</Hyperlink>
            </TextBlock>
        </StackPanel>

        <!-- ===== REJESTRACJA ===== -->
        <StackPanel Visibility="{Binding IsRegistering,
                                         Converter={StaticResource BoolToVis}}">
            <TextBox     Text="{Binding NewLogin}" md:HintAssist.Hint="Login"/>
            <TextBox     Text="{Binding Email}"    md:HintAssist.Hint="E-mail" Margin="0 8 0 0"/>
            <PasswordBox md:HintAssist.Hint="Hasło"           Margin="0 8 0 0" PasswordChanged="PwdChangedRegister"/>
            <PasswordBox md:HintAssist.Hint="Powtórz hasło"   Margin="0 8 0 0" PasswordChanged="PwdChangedRepeat"/>

            <TextBlock Text="{Binding Error}" Foreground="Red" TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0 12 0 0">
                <Button Content="Wstecz"     Click="ShowLoginClick"/>
                <Button Content="Zarejestruj"
                        Margin="12 0 0 0"
                        IsDefault="True"
                        Command="{Binding SubmitRegisterCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
