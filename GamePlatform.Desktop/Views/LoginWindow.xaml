<Window x:Class="GamePlatform.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:ctrl="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:conv="clr-namespace:GamePlatform.Desktop.Converters"
        Title="Logowanie"
        Width="720" Height="440"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource MaterialDesignWindow}">

    <Grid KeyDown="OnKeyDown">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="{DynamicResource MaterialDesignPaper}"
                Padding="32"
                ctrl:ShadowAssist.ShadowDepth="Depth_2dp">

            <StackPanel>
                <TextBlock Text="Game Platform"
                           FontSize="24" FontWeight="Bold" Margin="0 0 0 24"/>

                <!-- Formularz Logowania -->
                <StackPanel Visibility="{Binding IsRegistering, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                    <TextBox Text="{Binding Login}" md:HintAssist.Hint="Login lub e-mail"/>

                    <DockPanel Margin="0 8 0 0" LastChildFill="False">
                        <PasswordBox x:Name="PwdHidden" Width="220"
                                     PasswordChanged="PwdChanged"
                                     md:HintAssist.Hint="Hasło"
                                     Visibility="{Binding ShowPassword, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                        <TextBox x:Name="PwdVisible" Width="220"
                                 Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                                 TextChanged="PwdVisibleChanged"
                                 md:HintAssist.Hint="Hasło"
                                 Visibility="{Binding ShowPassword, Converter={StaticResource BoolToVis}}"/>
                        <CheckBox Content="👁" Margin="8 0 0 0"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding ShowPassword}"/>
                    </DockPanel>

                    <CheckBox Content="Zapamiętaj mnie"
                              IsChecked="{Binding RememberMe}"
                              Margin="0 4 0 0"/>

                    <TextBlock Text="{Binding Error}" Foreground="Red" TextWrapping="Wrap"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 16 0 0">
                        <Button Content="Rejestracja" Click="ShowRegisterClick"/>
                        <Button Content="Zaloguj" Margin="12 0 0 0"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Command="{Binding SubmitLoginCommand}"
                                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                                IsDefault="True"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <Image Grid.Column="1"
               Source="/Resources/login_banner.png"
               Stretch="UniformToFill"/>
    </Grid>
</Window>
