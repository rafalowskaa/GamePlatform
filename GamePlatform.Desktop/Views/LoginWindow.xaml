<Window x:Class="GamePlatform.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Logowanie"
        Width="720" Height="440"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource MaterialDesignWindow}"
        KeyDown="OnKeyDown">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═════════════  LEWA KOLUMNA  ═════════════ -->
        <Border Background="{DynamicResource MaterialDesignPaper}" Padding="32">
            <Grid>

                <!-- ■■■■■■■■■■■■■■■  PANEL LOGOWANIA  ■■■■■■■■■■■■■■■ -->
                <StackPanel x:Name="LoginPanel">
                    <!-- widoczność / ukrycie -->
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRegistering}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="Game Platform"
                           FontSize="24" FontWeight="Bold" Margin="0 0 0 24"/>

                    <!-- LOGIN -->
                    <TextBox TabIndex="0"
                         Text="{Binding Login}"
                         md:HintAssist.Hint="Login lub e-mail"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>

                    <!-- HASŁO (ukryte / jawne) -->
                    <Grid Margin="0 8 0 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>

                        <!-- PasswordBox (ukryty) -->
                        <PasswordBox x:Name="PwdHidden"
                                 Grid.Column="0" TabIndex="1"
                                 PasswordChanged="PwdChanged"
                                 md:HintAssist.Hint="Hasło">
                            <PasswordBox.Style>
                                <Style TargetType="PasswordBox"
                                   BasedOn="{StaticResource MaterialDesignFloatingHintPasswordBox}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowPassword}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </PasswordBox.Style>
                        </PasswordBox>

                        <!-- TextBox (jawny) -->
                        <TextBox x:Name="PwdVisible"
                             Grid.Column="0" TabIndex="1"
                             Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                             TextChanged="PwdVisibleChanged"
                             md:HintAssist.Hint="Hasło">
                            <TextBox.Style>
                                <Style TargetType="TextBox"
                                   BasedOn="{StaticResource MaterialDesignFloatingHintTextBox}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowPassword}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <!-- „oko” -->
                        <CheckBox Grid.Column="1"
                              Content="👁"
                              IsTabStop="False"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Center"
                              IsChecked="{Binding ShowPassword}"/>
                    </Grid>

                    <CheckBox TabIndex="2"
                          Content="Zapamiętaj mnie"
                          IsChecked="{Binding RememberMe}"
                          Margin="0 4 0 0"/>

                    <TextBlock Text="{Binding Error}"
                           Foreground="Red"
                           TextWrapping="Wrap"/>

                    <!-- PRZYCISKI -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            Margin="0 16 0 0">
                        <Button Content="Rejestracja"
                            Click="ShowRegisterClick" TabIndex="3"/>
                        <Button Content="Zaloguj" Margin="12 0 0 0" TabIndex="4"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Command="{Binding SubmitLoginCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                            IsDefault="True"/>
                    </StackPanel>
                </StackPanel>

                <!-- ■■■■■■■■■■■■■■■  PANEL REJESTRACJI  ■■■■■■■■■■■■■■■ -->
                <StackPanel x:Name="RegisterPanel">
                    <!-- widoczność / ukrycie -->
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRegistering}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="Nowe konto"
                           FontSize="24" FontWeight="Bold" Margin="0 0 0 24"/>

                    <!-- LOGIN -->
                    <TextBox TabIndex="0"
                         Text="{Binding NewLogin}"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         md:HintAssist.Hint="Login"/>

                    <!-- E-MAIL -->
                    <TextBox TabIndex="1" Margin="0 8 0 0"
                         Text="{Binding Email}"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         md:HintAssist.Hint="E-mail"/>

                    <!-- HASŁO 1 -->
                    <Grid Margin="0 8 0 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>

                        <!-- ukryty -->
                        <PasswordBox x:Name="RegPwdHidden"
                                 Grid.Column="0" TabIndex="2"
                                 PasswordChanged="PwdChangedRegister"
                                 md:HintAssist.Hint="Hasło">
                            <PasswordBox.Style>
                                <Style TargetType="PasswordBox"
                                   BasedOn="{StaticResource MaterialDesignFloatingHintPasswordBox}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowRegPassword}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </PasswordBox.Style>
                        </PasswordBox>

                        <!-- jawny -->
                        <TextBox x:Name="RegPwdVisible"
                             Grid.Column="0" TabIndex="2"
                             Text="{Binding RegPassword, UpdateSourceTrigger=PropertyChanged}"
                             TextChanged="RegPwdVisibleChanged"
                             md:HintAssist.Hint="Hasło">
                            <TextBox.Style>
                                <Style TargetType="TextBox"
                                   BasedOn="{StaticResource MaterialDesignFloatingHintTextBox}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowRegPassword}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <CheckBox Grid.Column="1"
                              Content="👁"
                              IsTabStop="False"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Center"
                              IsChecked="{Binding ShowRegPassword}"/>
                    </Grid>

                    <!-- HASŁO 2 -->
                    <PasswordBox Margin="0 8 0 0" TabIndex="3"
                            Style="{StaticResource MaterialDesignFloatingHintPasswordBox}"
                            md:HintAssist.Hint="Powtórz hasło"
                            PasswordChanged="PwdChangedRepeat"
                            HorizontalAlignment="Stretch"/>

                    <TextBlock Text="{Binding Error}"
                           Foreground="Red"
                           TextWrapping="Wrap"/>

                    <!-- PRZYCISKI -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            Margin="0 16 0 0">
                        <Button Content="↩︎ Logowanie" Click="ShowLoginClick"
                            TabIndex="4"/>
                        <Button Content="Utwórz konto" Margin="12 0 0 0"
                            TabIndex="5"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Command="{Binding SubmitRegisterCommand}"
                            IsDefault="True"/>
                    </StackPanel>
                </StackPanel>

            </Grid>
        </Border>

        <!-- ═════════════  PRAWA KOLUMNA  ═════════════ -->
        <Image Grid.Column="1"
               Source="pack://application:,,,/Resources/login_banner.png"
               Stretch="UniformToFill"/>
    </Grid>
</Window>
