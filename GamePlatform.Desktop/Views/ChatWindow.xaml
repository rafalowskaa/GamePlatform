<Window x:Class="GamePlatform.Desktop.Views.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:GamePlatform.Desktop.ViewModels"
        Title="{Binding Mate.Login, StringFormat=Czat – {0}}"
        Width="420" Height="560"
        Style="{StaticResource MaterialDesignWindow}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== HISTORIA ===== -->
        <ListBox ItemsSource="{Binding Messages}"
                 Background="Transparent" BorderThickness="0"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ChatWindowViewModel.ChatMessageView}">
                    <Border Margin="0 4" Padding="6" CornerRadius="6">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Margin" Value="0 4"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ContinuePrev}" Value="True">
                                        <Setter Property="Margin" Value="0 1"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.Background>
                            <MultiBinding Converter="{StaticResource MsgBg}">
                                <Binding Path="FromId"/>
                                <Binding Path="DataContext.Me.Id"
                                         RelativeSource="{RelativeSource AncestorType=Window}"/>
                            </MultiBinding>
                        </Border.Background>
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Foreground="White">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ContinuePrev}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource MsgSender}">
                                        <Binding Path="FromId"/>
                                        <Binding Path="DataContext.Me.Id" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                        <Binding Path="DataContext.Me.Login" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                        <Binding Path="DataContext.Mate.Login" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="White" Margin="0,2,0,0"/>
                            <TextBlock FontSize="11" Foreground="#aaa" HorizontalAlignment="Right">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ContinuePrev}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                                <TextBlock.Text>
                                    <Binding Path="WhenUtc" StringFormat="{}{0:dd.MM HH\\:mm}"/>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- ===== SEPARATOR ===== -->
        <Separator Grid.Row="1" Margin="0,8"/>

        <!-- ===== INPUT ===== -->
        <DockPanel Grid.Row="2" Margin="0 4 0 0">
            <TextBox DockPanel.Dock="Left"
                     Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                     Width="300" Height="32"
                     KeyDown="TextBox_KeyDown"/>
            <Button Content="Wyślij" Width="80" Margin="8 0 0 0"
                    Background="Black" Foreground="White" BorderBrush="Black"
                    Command="{Binding SendCommand}"/>
        </DockPanel>
    </Grid>
</Window>
