<Window x:Class="GamePlatform.Desktop.Views.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:GamePlatform.Desktop.ViewModels"
        Title="{Binding Mate.Login, StringFormat=Czat – {0}}"
        Width="420" Height="560"
        Style="{StaticResource MaterialDesignWindow}">
    <Window.Resources>
        <InputBindingCollection x:Key="SendOnEnterBindings">
            <KeyBinding Key="Enter" Command="{Binding SendCommand}"/>
            <KeyBinding Key="Enter" Modifiers="Alt" Command="{x:Static EditingCommands.InsertLineBreak}"/>
        </InputBindingCollection>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== HISTORIA ===== -->
        <ListBox x:Name="History"
                 ItemsSource="{Binding Messages}"
                 Background="Transparent" BorderThickness="0"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemContainerStyle>
                <Style TargetType="{x:Type ListBoxItem}">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>

                <DataTemplate DataType="{x:Type vm:ChatMessageView}">
                    <Border Padding="6" CornerRadius="6"
                            Margin="{Binding ContinuePrev, Converter={StaticResource BoolToThickness}}"
                            Background="{Binding IsMine, Converter={StaticResource BoolToBrush}}"
                            HorizontalAlignment="{Binding IsMine, Converter={StaticResource BoolToAlign}}">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Foreground="White"
                                       Visibility="{Binding ShowMeta, Converter={StaticResource BoolToVis}}"
                                       Text="{Binding SenderLogin}"/>
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="White" Margin="0,2,0,0"/>
                            <TextBlock FontSize="11" Foreground="#aaa" HorizontalAlignment="Right"
                                       Visibility="{Binding ShowMeta, Converter={StaticResource BoolToVis}}"
                                       Text="{Binding WhenLocal, StringFormat={}{0:dd.MM HH\\:mm}}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- ===== SEPARATOR ===== -->
        <Separator Grid.Row="1" Margin="0,8"/>

        <!-- ===== INPUT ===== -->
        <DockPanel Grid.Row="2" Margin="0 4 0 0">
            <TextBox DockPanel.Dock="Left"
                     Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                     Width="300" Height="32"
                     AcceptsReturn="True"
                     InputBindings="{StaticResource SendOnEnterBindings}"/>
            <Button Content="Wyślij" Width="80" Margin="8 0 0 0"
                    Background="Black" Foreground="White" BorderBrush="Black"
                    Command="{Binding SendCommand}"/>
        </DockPanel>
    </Grid>
</Window>
