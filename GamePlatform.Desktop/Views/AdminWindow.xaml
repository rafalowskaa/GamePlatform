<Window x:Class="GamePlatform.Desktop.Views.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Panel administratora" Width="1000" Height="600"
        Style="{StaticResource MaterialDesignWindow}">
    <DataGrid ItemsSource="{Binding Games}"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              Margin="12">
        <DataGrid.Columns>
            <DataGridTextColumn Header="Tytuł" Binding="{Binding Title}"/>
            <DataGridTextColumn Header="Kategoria" Binding="{Binding Category}"/>
            <DataGridTextColumn Header="Tryb" Binding="{Binding Mode}"/>
            <DataGridCheckBoxColumn Header="✔" Binding="{Binding IsApproved}"/>
            <DataGridTextColumn Header="#Grane" Binding="{Binding Scores.Count}"/>
        </DataGrid.Columns>
    </DataGrid>
</Window>
