<Page x:Class="GamePlatform.Desktop.Views.StatsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:loc="clr-namespace:GamePlatform.Desktop.Localization">

    <DockPanel Margin="24">

        <!-- ComboBox wyboru gry -->
        <ComboBox DockPanel.Dock="Top"
                  Width="260"
                  ItemsSource="{Binding Games}"
                  SelectedItem="{Binding SelectedGame}"
                  md:HintAssist.Hint="{loc:Loc CHOOSE_GAME}"/>

        <!-- tabela TOP 50 -->
        <DataGrid ItemsSource="{Binding Top}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{loc:Loc PLAYER}" Binding="{Binding Player}" Width="2*"/>
                <DataGridTextColumn Header="{loc:Loc SCORE}" Binding="{Binding Value}"  Width="*"/>
                <DataGridTextColumn Header="{loc:Loc DATE}"  Binding="{Binding CreatedUtc}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Page>
