<Page x:Class="GamePlatform.Desktop.Views.StatsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">

    <DockPanel Margin="24">

        <!-- ComboBox wyboru gry -->
        <ComboBox DockPanel.Dock="Top"
                  Width="260"
                  ItemsSource="{Binding Games}"
                  SelectedItem="{Binding SelectedGame}"
                  md:HintAssist.Hint="Wybierz grę"/>

        <!-- tabela TOP 50 -->
        <DataGrid ItemsSource="{Binding Top}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Gracz" Binding="{Binding Player}" Width="2*"/>
                <DataGridTextColumn Header="Wynik" Binding="{Binding Value}"  Width="*"/>
                <DataGridTextColumn Header="Data"  Binding="{Binding CreatedUtc}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Page>
