<Page x:Class="GamePlatform.Desktop.Views.GamesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:conv="clr-namespace:GamePlatform.Desktop.Converters"
      xmlns:models="clr-namespace:GamePlatform.Shared.Models;assembly=GamePlatform.Shared"
      xmlns:loc="clr-namespace:GamePlatform.Desktop.Localization">

    
    <Page.Resources>
    <conv:CoverImageConverter x:Key="CoverConv"/>
    </Page.Resources>

    <DockPanel Margin="12">

        <!-- top bar -->
        
            
                     <DockPanel DockPanel.Dock="Top" Margin="0 0 0 8">
            <TextBox Width="260" DockPanel.Dock="Left"
                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                     md:HintAssist.Hint="{loc:Loc SEARCH}"/>
            <Button DockPanel.Dock="Right"
                    MinWidth="110" Padding="12 4"
                    Background="Black" Foreground="White" BorderBrush="Black"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    HorizontalAlignment="Right"
                    Click="OnAddGameClick"
                    Content="{loc:Loc ADD_GAME}"/>
            
    </DockPanel>

    <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- galerie -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Width="440">
                <ItemsControl ItemsSource="{Binding Games}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="200" Height="260" Margin="4" BorderBrush="Gray" BorderThickness="1">
                                <Grid>
                                    <Button Content="❤" Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}"
                                            Background="Transparent" BorderThickness="0" Foreground="Red" HorizontalAlignment="Right"/>
                                    <StackPanel MouseLeftButtonUp="OnTileClick">
                                        <Image Height="220" Width="200" Stretch="UniformToFill"
                                               Source="{Binding Versions[0].FolderPath, Converter={StaticResource CoverConv}}"/>
                                        <TextBlock Text="{Binding Title}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        
            <!-- overlay szczegółów -->
            <Grid Grid.ColumnSpan="2" Background="#80000000"
                  Visibility="{Binding SelectedGame, Converter={StaticResource NullToVis}}"
                  MouseDown="OnOverlayClick">
                <Border Background="{DynamicResource MaterialDesignPaper}" Padding="12" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <md:TransitioningContent Content="{Binding SelectedGame}">
                        <md:TransitioningContent.ContentTemplate>
                            <DataTemplate DataType="{x:Type models:Game}">
                                <StackPanel Margin="12">
                                    <Image Height="220" Width="300" Stretch="Uniform"
                                           Source="{Binding Versions[0].FolderPath, Converter={StaticResource CoverConv}}"/>
                                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" Margin="0 8 0 0"/>
                                    <TextBlock Text="{Binding Category}"/>
                                    <TextBlock Text="{Binding Mode}"/>
                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0 8 0 8"/>
                                    <Button Content="{loc:Loc PLAY}" Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}"
                                            Style="{StaticResource MaterialDesignRaisedButton}" Background="Black" BorderBrush="Black" Foreground="White" Width="172" HorizontalAlignment="Left"/>
                                    <Button Background="Black" BorderBrush="Black" Foreground="White" Width="172" HorizontalAlignment="Left" Margin="0 8 0 0"
                                             Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                                <Setter Property="Content" Value="{loc:Loc ADD_TO_FAVORITES}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                        <Setter Property="Content" Value="{loc:Loc REMOVE_FROM_FAVORITES}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="{loc:Loc DELETE}" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}"
                                            Style="{StaticResource MaterialDesignRaisedButton}" Background="Red" BorderBrush="Red" Foreground="White" Width="172" HorizontalAlignment="Left" Margin="0 8 0 0"
                                            Visibility="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </md:TransitioningContent.ContentTemplate>
                    </md:TransitioningContent>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Page>
