<Page x:Class="GamePlatform.Desktop.Views.GamesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:conv="clr-namespace:GamePlatform.Desktop.Converters"
      xmlns:models="clr-namespace:GamePlatform.Shared.Models;assembly=GamePlatform.Shared">

    <Page.Resources>
    <conv:CoverImageConverter x:Key="CoverConv"/>
    </Page.Resources>

    <DockPanel Margin="12">

        <!-- top bar -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0 0 0 8">
            <TextBox Width="260"
                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                     md:HintAssist.Hint="Szukaj…"/>
            <Button Content="Dodaj" Background="Black" Foreground="White" BorderBrush="Black"
                    Command="{Binding AddGameAsyncCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Margin="12 0"/>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- galerie -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Width="440">
                <ItemsControl ItemsSource="{Binding Games}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="200" Height="260" Margin="4" BorderBrush="Gray" BorderThickness="1">
                                <StackPanel MouseLeftButtonUp="OnTileClick">
                                    <Image Height="220" Width="200" Stretch="UniformToFill"
                                           Source="{Binding Versions[0].FolderPath, Converter={StaticResource CoverConv}}"/>
                                    <TextBlock Text="{Binding Title}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- szczegóły -->
            <md:TransitioningContentControl Grid.Column="1" Content="{Binding SelectedGame}">
                <md:TransitioningContentControl.ContentTemplate>
                    <DataTemplate DataType="{x:Type models:Game}">
                        <StackPanel Margin="12">
                            <Image Height="220" Width="300" Stretch="Uniform"
                                   Source="{Binding Versions[0].FolderPath, Converter={StaticResource CoverConv}}"/>
                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" Margin="0 8 0 0"/>
                            <TextBlock Text="{Binding Category}"/>
                            <TextBlock Text="{Binding Mode}"/>
                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0 8 0 8"/>
                            <Button Content="Zagraj" Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}"/>
                        </StackPanel>
                    </DataTemplate>
                </md:TransitioningContentControl.ContentTemplate>
            </md:TransitioningContentControl>
        </Grid>
    </DockPanel>
</Page>
