<Page x:Class="GamePlatform.Desktop.Views.NotificationCenterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Powiadomienia">
    <DockPanel Margin="24">
        <Button Content="Usuń zaznaczone" DockPanel.Dock="Bottom"
                Margin="0,8,0,0"
                Click="RemoveSelected_Click"/>
        <ListBox x:Name="List" ItemsSource="{Binding History}"/>
    </DockPanel>
</Page>