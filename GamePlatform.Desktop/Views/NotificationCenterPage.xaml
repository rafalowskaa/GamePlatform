<Page x:Class="GamePlatform.Desktop.Views.NotificationCenterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:loc="clr-namespace:GamePlatform.Desktop.Localization"
       Title="{loc:Loc NOTIFICATIONS}">
    <DockPanel Margin="24">
        <ListBox x:Name="List" ItemsSource="{Binding History}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="0,0,0,4">
                        <Button Width="16" Height="16" Padding="0" Margin="4,0,0,0"
                                DockPanel.Dock="Right"
                                Background="Black" Foreground="White"
                                Content="✖"
                                Click="RemoveItem_Click"/>
                        <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Page>