<Page x:Class="GamePlatform.Desktop.Views.PendingRequestsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:loc="clr-namespace:GamePlatform.Desktop.Localization"
      Title="Oczekujące zaproszenia">

    <Page.Resources>
        <Style TargetType="DataGridCell">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <!-- style rows so they are not highlighted and content is centered -->
        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>
    
    <DockPanel Margin="24">

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
            <Button Content="{loc:Loc REFRESH}" Command="{Binding RefreshCommand}" Width="90"
                    Background="Black" Foreground="White" BorderBrush="Black"/>
            <Button Content="{loc:Loc PRINT}" Width="90" Margin="8 0 0 0" Click="OnPrintClick"
                    Background="Black" Foreground="White" BorderBrush="Black"/>
        </StackPanel>

        <DataGrid x:Name="RequestsGrid" ItemsSource="{Binding Requests}" AutoGenerateColumns="False"
                  IsReadOnly="True" Margin="0 12 0 0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{loc:Loc FROM}"    Binding="{Binding FromUserId}" Width="*"/>
                <DataGridTextColumn Header="{loc:Loc WHEN}" Binding="{Binding SentUtc}"    Width="120"/>

                <!-- —— AKCJE —— -->
                <DataGridTemplateColumn Header="" Width="160">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <!-- ✔ AKCEPTUJ -->
                                <Button Content="{loc:Loc ACCEPT}" Width="70"
                                        Background="Black" Foreground="White" BorderBrush="Black"
                                        Command="{Binding DataContext.AcceptCommand,
                                                          RelativeSource={RelativeSource AncestorType=Page}}"
                                        CommandParameter="{Binding}"/>
                                <!-- ✖ ODRZUĆ -->
                                    <Button Content="{loc:Loc DECLINE}" Width="70" Margin="8 0 0 0"
                                        Background="Black" Foreground="White" BorderBrush="Black"
                                        Command="{Binding DataContext.DeclineCommand,
                                                          RelativeSource={RelativeSource AncestorType=Page}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Page>
