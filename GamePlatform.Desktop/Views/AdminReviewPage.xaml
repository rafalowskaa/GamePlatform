<Page x:Class="GamePlatform.Desktop.Views.AdminReviewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
       xmlns:loc="clr-namespace:GamePlatform.Desktop.Localization"
       Title="{loc:Loc PENDING}">
    <Page.Resources>
        <Style x:Key="ActBtn" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="2"/>
        </Style>
        <Style x:Key="GridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Foreground"   Value="White"/>
            <Setter Property="Background"   Value="#222"/>
            <Setter Property="BorderBrush"  Value="#444"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#444"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </Page.Resources>
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
            <Button Content="{loc:Loc REFRESH}" Command="{Binding RefreshCommand}" Width="100"
                    Background="Black" Foreground="White" BorderBrush="Black"/>
            <Button Content="{loc:Loc PRINT}" Width="100" Margin="8 0 0 0" Click="OnPrintClick"
                    Background="Black" Foreground="White" BorderBrush="Black"/>
        </StackPanel>
        <DataGrid x:Name="GamesGrid" ItemsSource="{Binding Games}" AutoGenerateColumns="False"
                  IsReadOnly="True" Margin="0 8 0 0" CanUserResizeColumns="False"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ColumnHeaderStyle="{StaticResource GridHeaderStyle}" Loaded="OnGridLoaded">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{loc:Loc TITLE}" Binding="{Binding Title}" Width="*"/>
                <DataGridTextColumn Header="{loc:Loc VERSION}" Binding="{Binding Versions[0].Number}" Width="80"/>
                <DataGridTextColumn Header="{loc:Loc PLAYER}" Binding="{Binding SubmittedByUser.Login}" Width="*"/>
                <DataGridTextColumn Header="{loc:Loc DATE}" Binding="{Binding SubmittedAt}" Width="140"/>
                <DataGridTemplateColumn Header="{loc:Loc ACTIONS}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource ActBtn}" Content="{loc:Loc PLAY}"
                                        Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                        CommandParameter="{Binding}"/>
                                <Button Style="{StaticResource ActBtn}" Content="{loc:Loc APPROVE}"
                                        Command="{Binding DataContext.ApproveCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                        CommandParameter="{Binding}"/>
                                <Button Style="{StaticResource ActBtn}" Content="{loc:Loc REQUEST_FIX}"
                                        Command="{Binding DataContext.RequestFixCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                        CommandParameter="{Binding}"/>
                                <Button Style="{StaticResource ActBtn}" Content="{loc:Loc DELETE}"
                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel> 
</Page>