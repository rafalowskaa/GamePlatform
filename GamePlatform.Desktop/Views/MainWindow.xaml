<Window x:Class="GamePlatform.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:GamePlatform.Shared.Enums;assembly=GamePlatform.Shared"
        Title="Launcher" Width="900" Height="500"
        Style="{StaticResource MaterialDesignWindow}">

    <DockPanel Margin="16">

        <!-- górny pasek: wyszukiwarka + przycisk dodawania -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0 0 0 8">
            <TextBox Width="240" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                     md:HintAssist.Hint="Szukaj…"/>
            <Button Content="Dodaj"
                    Command="{Binding AddGameCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Margin="8 0"/>
        </StackPanel>

        <!-- lista gier -->
        <ListView ItemsSource="{Binding Games}"
                  x:Name="GameList"
                  ContextMenuOpening="OnCtx">

            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Title}"  FontWeight="Bold"/>
                        <TextBlock Text=" • "/>
                        <TextBlock Text="{Binding Category}"/>
                        <TextBlock Text=" • "/>
                        <TextBlock Text="{Binding Mode}"/>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>

        </ListView>
    </DockPanel>
</Window>
