<Window x:Class="GamePlatform.Desktop.Views.AddGameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:conv="clr-namespace:GamePlatform.Desktop.Converters;assembly=GamePlatform.Desktop"
        xmlns:enums="clr-namespace:GamePlatform.Shared.Enums;assembly=GamePlatform.Shared"
        Title="Dodaj grę"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource MaterialDesignWindow}">

    <StackPanel Margin="24" Width="340">

        <TextBox Text="{Binding Title}"
                 md:HintAssist.Hint="Tytuł"/>

        <TextBox Margin="0 8 0 0"
                 Text="{Binding Version}"
                 md:HintAssist.Hint="Wersja"/>

        <ComboBox Margin="0 8 0 0"
                  ItemsSource="{x:Static enums:EnumExtensions.CategoryValues}"
                  SelectedItem="{Binding SelectedCategory}"
                  md:HintAssist.Hint="Kategoria"/>

        <ComboBox ItemsSource="{x:Static enums:EnumExtensions.ModeValues}"
                  SelectedItem="{Binding SelectedMode}"
                  md:HintAssist.Hint="Tryb gry"/>

        <!-- MaxPlayers tylko dla MultiPlayer  -->
        <StackPanel Orientation="Horizontal" Margin="0 8 0 0">
            <TextBox Width="120"
                     Text="{Binding MaxPlayers}"
                     Visibility="{Binding SelectedMode,
                                          Converter={StaticResource ModeToVis}}"
                     md:HintAssist.Hint="Max graczy"/>
            <CheckBox Margin="12 0 0 0"
                      Content="Na żywo"
                      IsChecked="{Binding IsLive}"
                      VerticalAlignment="Center"/>
        </StackPanel>

        <TextBox Margin="0 8 0 0"
                 Text="{Binding Description}"
                 Height="64"
                 AcceptsReturn="True"
                 md:HintAssist.Hint="Opis"/>

        <DockPanel Margin="0 8 0 0">
            <TextBox Width="220"
                     DockPanel.Dock="Left"
                     Text="{Binding ZipPath}"
                     IsReadOnly="True"
                     md:HintAssist.Hint="Plik ZIP"/>
            <Button Content="…"
                    Width="34"
                    Margin="8 0 0 0"
                    Command="{Binding PickZipCommand}"/>
        </DockPanel>

        <TextBlock Text="{Binding Error}"
                   Foreground="Red"
                   TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0 12 0 0">
            <Button Content="Anuluj" IsCancel="True"/>
            <Button Content="Zapisz"
                    Margin="12 0 0 0"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Click="OnSubmit"
                    IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
