<Window x:Class="GamePlatform.Desktop.Views.AddGameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:enums="clr-namespace:GamePlatform.Shared.Enums;assembly=GamePlatform.Shared"
        Title="Dodaj grę"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource MaterialDesignWindow}">

    <StackPanel Margin="24" Width="340">

        <TextBox Text="{Binding Title}"
                 md:HintAssist.Hint="Tytuł"/>

        <TextBox Margin="0 8 0 0"
                 Text="{Binding Version}"
                 md:HintAssist.Hint="Wersja"/>

        <ComboBox Margin="0 8 0 0"
                  ItemsSource="{x:Static enums:EnumExtensions.CategoryValues}"
                  SelectedItem="{Binding SelectedCategory}"
                  md:HintAssist.Hint="Kategoria"/>

        <ComboBox ItemsSource="{x:Static enums:EnumExtensions.ModeValues}"
                  SelectedItem="{Binding SelectedMode}"
                  md:HintAssist.Hint="Tryb gry"/>

        <!-- MaxPlayers tylko dla MultiPlayer -->
        <StackPanel Orientation="Horizontal" Margin="0 8 0 0">
            <TextBox Width="120"
                     Text="{Binding MaxPlayers}"
                     md:HintAssist.Hint="Max graczy">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedMode}"
                                         Value="{x:Static enums:GameMode.MultiPlayer}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>

            <CheckBox Margin="12 0 0 0"
                      Content="Na żywo"
                      IsChecked="{Binding IsLive}"
                      VerticalAlignment="Center"/>
        </StackPanel>

        <TextBox Margin="0 8 0 0"
                 Text="{Binding Description}"
                 Height="64"
                 AcceptsReturn="True"
                 md:HintAssist.Hint="Opis"/>

        <DockPanel Margin="0 8 0 0">
            <TextBox Width="220"
                     DockPanel.Dock="Left"
                     Text="{Binding CoverPath}"
                     IsReadOnly="True"
                     md:HintAssist.Hint="Obraz gry (opcjonalnie)"/>
            <Button Content="…"
                    Width="34"
                    Margin="8 0 0 0"
                    Background="Black"
                    Foreground="White"
                    BorderBrush="Black"
                    Command="{Binding PickCoverCommand}"/>
        </DockPanel>

        <TextBlock Margin="0 4 0 0" Foreground="#999" TextWrapping="Wrap">
            Archiwum ZIP powinno zawierać plik <Bold>index.html</Bold> lub plik
            <Bold>.exe</Bold> w głównym folderze lub podfolderach.
        </TextBlock>

        <DockPanel Margin="0 8 0 0">
            <TextBox Width="220"
                     DockPanel.Dock="Left"
                     Text="{Binding ZipPath}"
                     IsReadOnly="True"
                     md:HintAssist.Hint="Plik ZIP"/>
            <Button Content="…"
                    Width="34"
                    Margin="8 0 0 0"
                    Background="Black"
                    Foreground="White"
                    BorderBrush="Black"
                    Command="{Binding PickZipCommand}"/>
        </DockPanel>

        <TextBlock Text="{Binding Error}"
                   Foreground="Red"
                   TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0 12 0 0">
            <Button Content="Anuluj" IsCancel="True"
                    Background="Black" Foreground="White" BorderBrush="Black"/>
            <Button Content="Zapisz"
                    Margin="12 0 0 0"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="Black" Foreground="White" BorderBrush="Black"
                    Click="OnSubmit"
                    IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
