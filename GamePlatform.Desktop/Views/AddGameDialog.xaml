<Window x:Class="GamePlatform.Desktop.Views.AddGameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:enums="clr-namespace:GamePlatform.Shared.Enums;assembly=GamePlatform.Shared"
        xmlns:loc="clr-namespace:GamePlatform.Desktop.Localization"
        Title="{loc:Loc ADD_GAME}"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource MaterialDesignWindow}">

    <StackPanel Margin="24" Width="340">

        <TextBox Text="{Binding TitlePl}"
                 md:HintAssist.Hint="{loc:Loc TITLE_PL}"/>
        <TextBox Margin="0 8 0 0"
                 Text="{Binding TitleEn}"
                 md:HintAssist.Hint="{loc:Loc TITLE_EN}"/>

        <TextBox Margin="0 8 0 0"
                 Text="{Binding Version}"
                 md:HintAssist.Hint="{loc:Loc VERSION}"/>

        <ComboBox Margin="0 8 0 0"
                  ItemsSource="{x:Static enums:EnumExtensions.CategoryValues}"
                  SelectedItem="{Binding SelectedCategory}"
                  md:HintAssist.Hint="{loc:Loc CATEGORY}"/>

        <ComboBox ItemsSource="{x:Static enums:EnumExtensions.ModeValues}"
                  SelectedItem="{Binding SelectedMode}"
                  md:HintAssist.Hint="{loc:Loc GAME_MODE}"/>

        <!-- MaxPlayers tylko dla MultiPlayer -->
        <StackPanel Orientation="Horizontal" Margin="0 8 0 0">
            <TextBox Width="120"
                     Text="{Binding MaxPlayers}"
                     md:HintAssist.Hint="{loc:Loc MAX_PLAYERS}">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedMode}"
                                         Value="{x:Static enums:GameMode.MultiPlayer}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>

            <CheckBox Margin="12 0 0 0"
                      Content="{loc:Loc LIVE}"
                      IsChecked="{Binding IsLive}"
                      VerticalAlignment="Center"/>
        </StackPanel>

        <TextBox Margin="0 8 0 0"
                 Text="{Binding DescriptionPl}"
                 Height="64"
                 AcceptsReturn="True"
                 md:HintAssist.Hint="{loc:Loc DESCRIPTION_PL}"/>

        <TextBox Margin="0 8 0 0"
                 Text="{Binding DescriptionEn}"
                 Height="64"
                 AcceptsReturn="True"
                  md:HintAssist.Hint="{loc:Loc DESCRIPTION_EN}"/>

        <DockPanel Margin="0 8 0 0">
            <TextBox Width="220"
                     DockPanel.Dock="Left"
                     Text="{Binding CoverPath}"
                     IsReadOnly="True"
                     md:HintAssist.Hint="{loc:Loc GAME_IMAGE_OPT}"/>
            <Button Content="…"
                    Width="34"
                    Margin="8 0 0 0"
                    Background="Black"
                    Foreground="White"
                    BorderBrush="Black"
                    Command="{Binding PickCoverCommand}"/>
        </DockPanel>

        <TextBlock Margin="0 4 0 0" Foreground="#999" TextWrapping="Wrap"
                   Text="{loc:Loc ZIP_INFO}"/>

        <DockPanel Margin="0 8 0 0">
            <TextBox Width="220"
                     DockPanel.Dock="Left"
                     Text="{Binding ZipPath}"
                     IsReadOnly="True"
                     md:HintAssist.Hint="{loc:Loc ZIP_FILE}"/>
            <Button Content="…"
                    Width="34"
                    Margin="8 0 0 0"
                    Background="Black"
                    Foreground="White"
                    BorderBrush="Black"
                    Command="{Binding PickZipCommand}"/>
        </DockPanel>

        <TextBlock Text="{Binding Error}"
                   Foreground="Red"
                   TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0 12 0 0">
            <Button Content="{loc:Loc CANCEL}" IsCancel="True"
                    Background="Black" Foreground="White" BorderBrush="Black"/>
            <Button Content="{loc:Loc SAVE}"
                    Margin="12 0 0 0"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="Black" Foreground="White" BorderBrush="Black"
                    Click="OnSubmit"
                    IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
