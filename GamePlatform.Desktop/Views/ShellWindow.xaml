<Window x:Class="GamePlatform.Desktop.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Launcher" Width="1100" Height="800"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource MaterialDesignWindow}">

    <Window.Resources>
        <!-- uniwersalny styl bazowy -->
        <Style x:Key="NavBtn"
               TargetType="Button"
               BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Padding"    Value="8 4"/>
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- górne menu -->
        <ToolBar DockPanel.Dock="Top"
                 Background="{DynamicResource MaterialDesignPaper}">

            <!-- ====== GRY ====== -->
            <Button Content="Gry"
                    Command="{Binding ShowGamesCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource NavBtn}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentPageTag}" Value="Games">
                                <Setter Property="Background" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- ====== PROFIL ====== -->
            <Button Content="Profil"
                    Command="{Binding ShowProfileCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource NavBtn}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentPageTag}" Value="Profile">
                                <Setter Property="Background" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- ====== ZNAJOMI ====== -->
            <Button Content="Znajomi"
                    Command="{Binding ShowFriendsCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource NavBtn}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentPageTag}" Value="Friends">
                                <Setter Property="Background" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- ====== STATYSTYKI ====== -->
            <Button Content="Statystyki"
                    Command="{Binding ShowStatsCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource NavBtn}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentPageTag}" Value="Stats">
                                <Setter Property="Background" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- ====== UŻYTKOWNICY (admin only) ====== -->
            <Button Content="Użytkownicy"
                    Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"
                    Command="{Binding ShowUsersCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource NavBtn}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentPageTag}" Value="Users">
                                <Setter Property="Background" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Separator/>

            <Button Content="Wyloguj"
                    Command="{Binding LogoutCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}"/>
        </ToolBar>

        <Frame Content="{Binding CurrentPage}"/>
    </DockPanel>
</Window>
