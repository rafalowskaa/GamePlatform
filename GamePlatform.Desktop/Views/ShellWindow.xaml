<Window x:Class="GamePlatform.Desktop.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:GamePlatform.Desktop.Converters;assembly=GamePlatform.Desktop"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Launcher" Width="900" Height="600"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource MaterialDesignWindow}">

    <!-- styl przycisku menu -->
    <Window.Resources>
        <Style x:Key="NavBtn"
               TargetType="Button"
               BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Padding"    Value="8 4"/>
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource Equals}">
                            <Binding Path="Tag" RelativeSource="{RelativeSource Self}"/>
                            <Binding Path="DataContext.CurrentPageTag"
                                     RelativeSource="{RelativeSource AncestorType=Window}"/>
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Background" Value="{DynamicResource PrimaryHueMidBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- górne menu -->
        <ToolBar DockPanel.Dock="Top"
                 Background="{DynamicResource MaterialDesignPaper}">
            <Button Content="Gry"        Tag="Games"   Style="{StaticResource NavBtn}"
                    Command="{Binding ShowGamesCommand}"/>
            <Button Content="Profil"     Tag="Profile" Style="{StaticResource NavBtn}"
                    Command="{Binding ShowProfileCommand}"/>
            <Button Content="Znajomi"    Tag="Friends" Style="{StaticResource NavBtn}"
                    Command="{Binding ShowFriendsCommand}"/>
            <Button Content="Statystyki" Tag="Stats"   Style="{StaticResource NavBtn}"
                    Command="{Binding ShowStatsCommand}"/>
            <Button Content="Użytkownicy" Tag="Users"  Style="{StaticResource NavBtn}"
                    Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"
                    Command="{Binding ShowUsersCommand}"/>

            <Separator/>
            <Button Content="Wyloguj"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Command="{Binding LogoutCommand}"/>
        </ToolBar>

        <Frame Content="{Binding CurrentPage}"/>
    </DockPanel>
</Window>
