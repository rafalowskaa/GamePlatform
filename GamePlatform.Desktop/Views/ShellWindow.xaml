<Window x:Class="GamePlatform.Desktop.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:views="clr-namespace:GamePlatform.Desktop.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Launcher"
        Width="1100" Height="800"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource MaterialDesignWindow}"
        DataContext="{Binding RelativeSource={RelativeSource Self}, Path=ShellVM}">

    <!--  VM wstrzykiwany w code-behind  -->
    <Window.Resources>
        <Style x:Key="NavBtn" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Padding"    Value="10 4"/>
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
        </Style>
    </Window.Resources>

    <md:DrawerHost IsRightDrawerOpen="{Binding IsDrawerOpen}">
        <md:DrawerHost.RightDrawerContent>
            <views:FriendsPage DataContext="{Binding FriendsVm}"/>
        </md:DrawerHost.RightDrawerContent>

        <Grid>
            <DockPanel>

                <DockPanel DockPanel.Dock="Top">
                    <Button DockPanel.Dock="Right" Content="Wyloguj" Style="{StaticResource MaterialDesignFlatButton}" Command="{Binding LogoutCommand}"/>
                    <TabControl SelectionChanged="OnTabChanged" Background="{DynamicResource MaterialDesignPaper}" SelectedIndex="{Binding SelectedTabIndex}">
                        <TabItem Header="Gry" Tag="Games" Style="{StaticResource MainTabItemStyle}"/>
                        <TabItem Header="Profil" Tag="Profile" Style="{StaticResource MainTabItemStyle}"/>
                        <TabItem Header="Statystyki" Tag="Stats" Style="{StaticResource MainTabItemStyle}"/>
                        <TabItem Header="Powiadomienia" Tag="Notify" Style="{StaticResource MainTabItemStyle}"/>
                        <TabItem Header="Do akceptacji" Tag="Pending" Style="{StaticResource MainTabItemStyle}" Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"/>
                        <TabItem Header="Zgłoszenia" Tag="Reports" Style="{StaticResource MainTabItemStyle}" Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"/>
                        <TabItem Header="Użytkownicy" Tag="Users" Style="{StaticResource MainTabItemStyle}" Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"/>
                    </TabControl>
                </DockPanel>

                <!--  zawartość  -->
                <Frame Content="{Binding CurrentPage}"
                       NavigationUIVisibility="Hidden"/>
                <!-- globalny snackbar na komunikaty -->
                <md:Snackbar MessageQueue="{StaticResource GlobalMsgQueue}"
                             VerticalAlignment="Top"
                             HorizontalAlignment="Center"
                             Margin="0 50 0 0"
                             Panel.ZIndex="1"/>
            </DockPanel>

            <!-- uchwyt wysuwanego panelu znajomych -->
            <Button Width="40" Height="100"
                    Command="{Binding ToggleDrawerCommand}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,-16,0"
                    Background="Black"/>          
            
            
        </Grid>
    </md:DrawerHost>
</Window>
