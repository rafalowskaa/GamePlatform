<Window x:Class="GamePlatform.Desktop.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:views="clr-namespace:GamePlatform.Desktop.Views"
        xmlns:conv="clr-namespace:GamePlatform.Desktop.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:loc="clr-namespace:GamePlatform.Desktop.Localization"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Launcher"
        Width="1140"
        Height="800"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource MaterialDesignWindow}"
        DataContext="{Binding RelativeSource={RelativeSource Self}, Path=ShellVM}">

    <!-- skrót klawiszowy: Win + L → zmiana języka -->
    <Window.InputBindings>
        <KeyBinding Key="L" Modifiers="Windows" Command="{Binding ToggleLanguageCommand}"/>
    </Window.InputBindings>

    <md:DrawerHost IsRightDrawerOpen="{Binding IsDrawerOpen}">
        <md:DrawerHost.RightDrawerContent>
            <views:FriendsPage DataContext="{Binding FriendsVm}"/>
        </md:DrawerHost.RightDrawerContent>

        <Grid>
            <DockPanel>

                <!-- ░░░  HEADER  ░░░ -->
                <Border DockPanel.Dock="Top" Background="Black" Height="160" Padding="20,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.63*"/>
                            <ColumnDefinition Width="0.37*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Avatar + welcome text -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="110" Height="110" Margin="0,0,20,0">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding AvatarPath, Converter={StaticResource AvatarConverter}}"
                                                Stretch="UniformToFill"/>
                                </Ellipse.Fill>
                            </Ellipse>

                            <TextBlock FontSize="24" FontWeight="Bold" VerticalAlignment="Center" Foreground="White">
                                <Run Text="{Binding WelcomePrefix, Mode=OneWay}"/>
                                <Run Text="{Binding CurrentLogin, Mode=OneWay}" Foreground="DodgerBlue"/>
                                <Run Text="{Binding WelcomeSuffix, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>

                        <!-- rotating GP logo -->
                        <Border Grid.Column="1" Width="125" Height="125" CornerRadius="20" Background="Black"
                                HorizontalAlignment="Right" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <RotateTransform x:Name="LogoRot" Angle="0"/>
                            </Border.RenderTransform>

                            <Grid>
                                <Border CornerRadius="60">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#1133FF" Offset="0"/>
                                            <GradientStop Color="Black" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <TextBlock Text="GP" FontFamily="Chiller" FontSize="114" Foreground="White" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>

                            <Border.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="LogoRot" Storyboard.TargetProperty="Angle"
                                                             From="0" To="360" Duration="0:0:6"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                        </Border>
                    </Grid>
                </Border>

                <!-- ░░░  TAB STRIP + FLAGS + LOGOUT ░░░ -->
                <Grid DockPanel.Dock="Top" Height="48">


                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TabControl Grid.Column="0"
                                Style="{StaticResource SingleRowTabControl}"
                                Background="{DynamicResource MaterialDesignPaper}"
                                SelectedIndex="{Binding SelectedTabIndex}"
                                SelectionChanged="OnTabChanged">
                        <!-- user tabs -->
                        <TabItem Header="{loc:Loc GAMES}"         Tag="Games"   Style="{StaticResource MainTabItemStyle}"/>
                        <TabItem Header="{loc:Loc PROFILE}"       Tag="Profile" Style="{StaticResource MainTabItemStyle}"/>
                        <TabItem Header="{loc:Loc STATS}"         Tag="Stats"   Style="{StaticResource MainTabItemStyle}"/>
                        <TabItem Header="{loc:Loc NOTIFICATIONS}" Tag="Notify"  Style="{StaticResource MainTabItemStyle}"/>
                        <!-- admin tabs -->
                        <TabItem Header="{loc:Loc PENDING}"       Tag="Pending" Style="{StaticResource AdminTabItemStyle}"
                                 Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"/>
                        <TabItem Header="{loc:Loc REPORTS}"       Tag="Reports" Style="{StaticResource AdminTabItemStyle}"
                                 Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"/>
                        <TabItem Header="{loc:Loc USERS}"         Tag="Users"   Style="{StaticResource AdminTabItemStyle}"
                                 Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"/>
                        
                    </TabControl>
                    <!-- ❷ PANEL FLAG + WYLOGUJ -->
                    <StackPanel x:Name="NavPanel"                
                        Grid.Column="1"
                Orientation="Horizontal"
                Background="{StaticResource TabBlueBrush}">
                        <Button Style="{StaticResource FlagBtn}" Margin="8 0 0 0" Command="{Binding SetPolishCommand}">
                            <Image Width="30" Height="32" Stretch="Uniform"
                   Source="pack://application:,,,/Resources/flag_pl.png"/>
                        </Button>
                        <Button Style="{StaticResource FlagBtn}" Margin="4 0 0 0" Command="{Binding SetEnglishCommand}">
                            <Image Width="30" Height="32" Stretch="Uniform"
                   Source="pack://application:,,,/Resources/flag_gb.png"/>
                        </Button>
                        <Button Content="{loc:Loc LOGOUT}"
                Style="{StaticResource NavBtn}"
                Command="{Binding LogoutCommand}"/>
                    </StackPanel>
                </Grid>

                <!-- zawartość stron -->
                <Frame Content="{Binding CurrentPage}" NavigationUIVisibility="Hidden"/>

                <!-- snackbar -->
                <md:Snackbar MessageQueue="{StaticResource GlobalMsgQueue}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,50,0,0"/>
            </DockPanel>

            <!-- uchwyt do wysuwanego panelu znajomych -->
            <Button Width="30" Height="200" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-16,0"
                    Background="Black" BorderBrush="Black" Command="{Binding ToggleDrawerCommand}"/>
        </Grid>
    </md:DrawerHost>
</Window>
