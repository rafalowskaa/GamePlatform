<Window x:Class="GamePlatform.Desktop.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:views="clr-namespace:GamePlatform.Desktop.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Launcher"
        Width="1100" Height="800"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource MaterialDesignWindow}"
        DataContext="{Binding RelativeSource={RelativeSource Self}, Path=ShellVM}">

    <!--  VM wstrzykiwany w code-behind  -->
    <Window.Resources>
        <Style x:Key="NavBtn" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Padding"    Value="10 4"/>
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
        </Style>
    </Window.Resources>

    <md:DrawerHost IsRightDrawerOpen="{Binding IsDrawerOpen}">
        <md:DrawerHost.RightDrawerContent>
            <views:FriendsPage DataContext="{Binding FriendsVm}"/>
        </md:DrawerHost.RightDrawerContent>

        <Grid>
            <DockPanel>

            <!-- ======= GÓRNY PASEK NAWIGACJI ======= -->
            <ToolBar DockPanel.Dock="Top" Background="{DynamicResource MaterialDesignPaper}">

                <!-- każda pozycja: Games / Profile / Friends / Stats / Users -->
                <Button Content="Gry" Command="{Binding ShowGamesCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource NavBtn}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentTag}" Value="Games">
                                    <Setter Property="Background" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="Profil" Command="{Binding ShowProfileCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource NavBtn}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentTag}" Value="Profile">
                                    <Setter Property="Background" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                

                <Button Content="Statystyki" Command="{Binding ShowStatsCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource NavBtn}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentTag}" Value="Stats">
                                    <Setter Property="Background" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                    <Button Content="Powiadomienia" Command="{Binding ShowNotificationsCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavBtn}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentTag}" Value="Notify">
                                        <Setter Property="Background" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="Zgłoszenia"
                        Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"
                        Command="{Binding ShowReportsCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavBtn}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentTag}" Value="Reports">
                                        <Setter Property="Background" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="Użytkownicy"
                    Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"
                   
                    Command="{Binding ShowUsersCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource NavBtn}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentTag}" Value="Users">
                                    <Setter Property="Background" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Separator/>

                <Button Content="Wyloguj" Style="{StaticResource MaterialDesignFlatButton}" Command="{Binding LogoutCommand}"/>
            </ToolBar>

                <!--  zawartość  -->
                <Frame Content="{Binding CurrentPage}"
                       NavigationUIVisibility="Hidden"/>
                <!-- globalny snackbar na komunikaty -->
                <md:Snackbar MessageQueue="{StaticResource GlobalMsgQueue}"
                             VerticalAlignment="Top"
                             HorizontalAlignment="Center"
                             Margin="0 20 0 0"
                             Panel.ZIndex="1"/>
            </DockPanel>

            <!-- uchwyt wysuwanego panelu znajomych -->
            <Button Width="40" Height="100"
                    Command="{Binding ToggleDrawerCommand}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,-16,0"
                    Background="Black"/>          
            
            
        </Grid>
    </md:DrawerHost>
</Window>
