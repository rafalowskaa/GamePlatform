<Window x:Class="GamePlatform.Desktop.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:views="clr-namespace:GamePlatform.Desktop.Views"
        xmlns:conv="clr-namespace:GamePlatform.Desktop.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Launcher"
        Width="1100" Height="800"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource MaterialDesignWindow}"
        DataContext="{Binding RelativeSource={RelativeSource Self}, Path=ShellVM}">

    <!-- ░░░   zasoby specyficzne dla okna   ░░░ -->
    <Window.Resources>
        <ResourceDictionary>
            <!-- wczytanie wspólnego słownika stylów -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/LauncherStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- ░░░   GŁÓWNA STRUKTURA   ░░░ -->
    <md:DrawerHost IsRightDrawerOpen="{Binding IsDrawerOpen}">

        <!-- panel znajomych -->
        <md:DrawerHost.RightDrawerContent>
            <views:FriendsPage DataContext="{Binding FriendsVm}" />
        </md:DrawerHost.RightDrawerContent>

        <Grid>
            <DockPanel>

                <!-- █████  CZARNY GÓRNY PASEK  █████ -->
                <Border DockPanel.Dock="Top"
                        Background="Black"
                        Padding="8">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Spacing="8">

                        <!-- avatar przycięty do koła -->
                        <Border Width="48" Height="48"
                                CornerRadius="24"
                                ClipToBounds="True">
                            <Image Source="{Binding AvatarPath,
                                                    Converter={StaticResource AvatarConverter}}"
                                   Stretch="UniformToFill"/>
                        </Border>

                        <!-- tekst powitalny -->
                        <TextBlock FontWeight="Bold"
                                   FontSize="18"               
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap">
                            <Run Text="Witaj "/>
                            <Run Text="{Binding UserName}" Foreground="#1F5FFF"/> <!-- niebieska nazwa -->
                            <Run Text=", w co dziś zagramy?"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- █████  PASEK ZAKŁADEK + WYLOGUJ  █████ -->
                <DockPanel DockPanel.Dock="Top"
                           Margin="0,8,0,0">

                    <!-- przycisk Wyloguj -->
                    <Button DockPanel.Dock="Right"
                            Content="Wyloguj"
                            Style="{StaticResource NavBtn}"
                            Command="{Binding LogoutCommand}"/>

                    <!-- zakładki -->
                    <TabControl Background="{DynamicResource MaterialDesignPaper}"
                                SelectionChanged="OnTabChanged"
                                SelectedIndex="{Binding SelectedTabIndex}"
                                BorderThickness="0">

                        <!-- standardowe -->
                        <TabItem Header="Gry"
                                 Tag="Games"
                                 Style="{StaticResource MainTabItemStyle}"/>
                        <TabItem Header="Profil"
                                 Tag="Profile"
                                 Style="{StaticResource MainTabItemStyle}"/>
                        <TabItem Header="Statystyki"
                                 Tag="Stats"
                                 Style="{StaticResource MainTabItemStyle}"/>
                        <TabItem Header="Powiadomienia"
                                 Tag="Notify"
                                 Style="{StaticResource MainTabItemStyle}"/>

                        <!-- administracyjne (ciemniejszy niebieski) -->
                        <TabItem Header="Do akceptacji"
                                 Tag="Pending"
                                 Style="{StaticResource AdminTabItemStyle}"
                                 Visibility="{Binding IsAdmin,
                                                      Converter={StaticResource BoolToVis}}"/>
                        <TabItem Header="Zgłoszenia"
                                 Tag="Reports"
                                 Style="{StaticResource AdminTabItemStyle}"
                                 Visibility="{Binding IsAdmin,
                                                      Converter={StaticResource BoolToVis}}"/>
                        <TabItem Header="Użytkownicy"
                                 Tag="Users"
                                 Style="{StaticResource AdminTabItemStyle}"
                                 Visibility="{Binding IsAdmin,
                                                      Converter={StaticResource BoolToVis}}"/>
                    </TabControl>
                </DockPanel>

                <!-- █████  ZAWARTOŚĆ  █████ -->
                <Frame Content="{Binding CurrentPage}"
                       NavigationUIVisibility="Hidden"/>

                <!-- globalny snackbar -->
                <md:Snackbar MessageQueue="{StaticResource GlobalMsgQueue}"
                             VerticalAlignment="Top"
                             HorizontalAlignment="Center"
                             Margin="0 50 0 0"
                             Panel.ZIndex="1"/>
            </DockPanel>

            <!-- uchwyt wysuwanego panelu znajomych -->
            <Button Width="40" Height="100"
                    Command="{Binding ToggleDrawerCommand}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,-16,0"
                    Background="Black"/>
        </Grid>
    </md:DrawerHost>
</Window>
