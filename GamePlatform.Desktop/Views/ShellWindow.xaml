<Window x:Class="GamePlatform.Desktop.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:views="clr-namespace:GamePlatform.Desktop.Views"
        xmlns:conv="clr-namespace:GamePlatform.Desktop.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Launcher"
        Width="1100"
        Height="800"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource MaterialDesignWindow}"
        DataContext="{Binding RelativeSource={RelativeSource Self}, Path=ShellVM}">

    <md:DrawerHost IsRightDrawerOpen="{Binding IsDrawerOpen}">
        <md:DrawerHost.RightDrawerContent>
            <views:FriendsPage DataContext="{Binding FriendsVm}"/>
        </md:DrawerHost.RightDrawerContent>

        <Grid>
            <DockPanel>

                <!-- ░░░  HEADER  ░░░ -->
                <Border DockPanel.Dock="Top"
                        Background="Black"
                        Height="160"
                        Padding="20,16">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.63*"/>
                            <ColumnDefinition Width="0.37*"/>
                        </Grid.ColumnDefinitions>

                        <!-- avatar + welcome -->
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <Ellipse Width="110"
                                     Height="110"
                                     Margin="0,0,20,0">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding AvatarPath,
                                                        Converter={StaticResource AvatarConverter}}"
                                        Stretch="UniformToFill"/>
                                </Ellipse.Fill>
                            </Ellipse>

                            <TextBlock FontSize="24"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center">
                                <Run Text="Witaj "               Foreground="White"/>
                                <Run Text="{Binding CurrentLogin, Mode=OneWay}"
                                     Foreground="#1F5FFF"/>
                                <Run Text=", w co dziś zagramy?" Foreground="White"/>
                            </TextBlock>
                        </StackPanel>

                        <!-- animowane logo GP -->
                        <Border Grid.Column="1"
                                Width="125"
                                Height="125"
                                CornerRadius="20"
                                Background="Black"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <RotateTransform x:Name="LogoRot" Angle="0"/>
                            </Border.RenderTransform>

                            <Grid>
                                <Border CornerRadius="60">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#1133FF" Offset="0"/>
                                            <GradientStop Color="Black" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <TextBlock Text="GP"
                                           FontFamily="Chiller"
                                           FontSize="114"
                                           Foreground="White"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <!-- obroty -->
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="LogoRot"
                                                             Storyboard.TargetProperty="Angle"
                                                             From="0" To="360"
                                                             Duration="0:0:6"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                        </Border>
                    </Grid>
                </Border>

                <!-- ░░░  TABs + WYLOGUJ  ░░░ -->
                <DockPanel DockPanel.Dock="Top">
                    <Button DockPanel.Dock="Right"
                            Content="Wyloguj"
                            Style="{StaticResource NavBtn}"
                            Command="{Binding LogoutCommand}"/>

                    <TabControl Background="{DynamicResource MaterialDesignPaper}"
                                SelectedIndex="{Binding SelectedTabIndex}"
                                SelectionChanged="OnTabChanged">

                        <TabItem Header="Gry"           Tag="Games"   Style="{StaticResource MainTabItemStyle}"/>
                        <TabItem Header="Profil"        Tag="Profile" Style="{StaticResource MainTabItemStyle}"/>
                        <TabItem Header="Statystyki"    Tag="Stats"   Style="{StaticResource MainTabItemStyle}"/>
                        <TabItem Header="Powiadomienia" Tag="Notify"  Style="{StaticResource MainTabItemStyle}"/>

                        <TabItem Header="Do akceptacji" Tag="Pending"
                                 Style="{StaticResource AdminTabItemStyle}"
                                 Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"/>
                        <TabItem Header="Zgłoszenia"    Tag="Reports"
                                 Style="{StaticResource AdminTabItemStyle}"
                                 Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"/>
                        <TabItem Header="Użytkownicy"   Tag="Users"
                                 Style="{StaticResource AdminTabItemStyle}"
                                 Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"/>
                    </TabControl>
                </DockPanel>

                <!-- zawartość -->
                <Frame Content="{Binding CurrentPage}" NavigationUIVisibility="Hidden"/>

                <!-- snackbar -->
                <md:Snackbar MessageQueue="{StaticResource GlobalMsgQueue}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Top"
                             Margin="0,50,0,0"/>
            </DockPanel>

            <!-- drawer handle -->
            <Button Width="40"
                    Height="100"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,-16,0"
                    Background="Black"
                    Command="{Binding ToggleDrawerCommand}"/>
        </Grid>
    </md:DrawerHost>
</Window>
