<Window x:Class="GamePlatform.Desktop.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Launcher" Width="900" Height="600"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource MaterialDesignWindow}">

    <DockPanel>
        <!-- górny pasek -->
        <ToolBar DockPanel.Dock="Top"
                 Background="{DynamicResource MaterialDesignPaper}">
            <Button Content="Gry"         Command="{Binding ShowGamesCommand}"/>
            <Button Content="Profil"      Command="{Binding ShowProfileCommand}"/>
            <Button Content="Znajomi"     Command="{Binding ShowFriendsCommand}"/>
            <Button Content="Użytkownicy"
                    Visibility="{Binding IsAdmin,
                                         Converter={StaticResource BoolToVis}}"
                    Command="{Binding ShowUsersCommand}"/>
            <Separator/>
            <Button Content="Wyloguj"     Command="{Binding LogoutCommand}"/>
        </ToolBar>

        <!-- bieżąca strona -->
        <Frame Content="{Binding CurrentPage}"/>
    </DockPanel>
</Window>
