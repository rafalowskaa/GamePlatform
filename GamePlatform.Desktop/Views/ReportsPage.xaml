<Page x:Class="GamePlatform.Desktop.Views.ReportsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:conv="clr-namespace:GamePlatform.Desktop.Converters"
      Title="Zgłoszenia">
    <Page.Resources>
        <conv:ReportStatusConverter x:Key="ReportStatusConv"/>
        <conv:ReportStatusTextMultiConverter x:Key="ReportStatusTextConv"/>
        <conv:ReportStatusBrushMultiConverter x:Key="ReportStatusBrushConv"/>
        <Style x:Key="DarkToolTip" TargetType="ToolTip">
            <Setter Property="Background"  Value="#111"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="Padding"     Value="6"/>
            <Setter Property="BorderBrush" Value="#111"/>
        </Style>
        <Style x:Key="CloudVisibilityStyle" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Description}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Description.Length}" Value="0">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- czarny przycisk -->
        <Style x:Key="BlackBtn" TargetType="Button"
               BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="MinWidth"       Value="80"/>
            <Setter Property="Padding"        Value="6 2"/>
            <Setter Property="FontSize"       Value="11"/>
            <Setter Property="FontWeight"     Value="Bold"/>
            <Setter Property="Background"     Value="#111"/>
            <Setter Property="Foreground"     Value="White"/>
            <Setter Property="BorderBrush"    Value="#111"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <!-- style for all headers -->
        <Style x:Key="GridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Foreground"   Value="White"/>
            <Setter Property="Background"   Value="#222"/>
            <Setter Property="BorderBrush"  Value="#444"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#444"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WrapCell" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Page.Resources>
    <DockPanel Margin="12">
        <Button DockPanel.Dock="Top" Content="Odśwież" Width="100"
                Command="{Binding RefreshCommand}"
                Background="Black" Foreground="White" BorderBrush="Black"/>
        <DataGrid ItemsSource="{Binding Reports}" AutoGenerateColumns="False"
                  IsReadOnly="True" Margin="0 8 0 0"
                  CanUserResizeColumns="False"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ColumnHeaderStyle="{StaticResource GridHeaderStyle}">
            
            <DataGrid.Columns>
                <DataGridTextColumn Header="Data" Width="162" Binding="{Binding CreatedUtc}"/>
                <DataGridTextColumn Header="Zgłaszający" Width="*" Binding="{Binding Reporter.Login}"/>
                <DataGridTextColumn Header="Oskarżony" Width="*" Binding="{Binding ReportedUser.Login}"/>
                <DataGridTextColumn Header="Kategoria" Width="*" Binding="{Binding Category}"/>
                <DataGridTemplateColumn Header="Opis" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="☁" FontSize="14" Style="{StaticResource CloudVisibilityStyle}">
                                <TextBlock.ToolTip>
                                    <ToolTip Style="{StaticResource DarkToolTip}" Content="{Binding Description}"/>
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Status" MinWidth="80" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock FontWeight="Bold">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource ReportStatusTextConv}">
                                        <Binding Path="Status"/>
                                        <Binding Path="StaffNotes"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                                <TextBlock.Foreground>
                                    <MultiBinding Converter="{StaticResource ReportStatusBrushConv}">
                                        <Binding Path="Status"/>
                                        <Binding Path="StaffNotes"/>
                                    </MultiBinding>
                                </TextBlock.Foreground>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="AKCJE" MinWidth="160" Width="Auto">
                        <DataGridTemplateColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader"
                               BasedOn="{StaticResource GridHeaderStyle}">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGridTemplateColumn.HeaderStyle>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource BlackBtn}" Content="OSTRZEŻ" Command="{Binding DataContext.WarnCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}"/>
                                <Button Style="{StaticResource BlackBtn}" Margin="8 0 0 0" Content="ANULUJ" Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}"/>
                                <Button Style="{StaticResource BlackBtn}" Margin="8 0 0 0" Content="ZABLOKUJ" Command="{Binding DataContext.BlockUserCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}"/>
                                <Button Content="✖" Width="24" Margin="8 0 0 0"
                                        Background="#111" Foreground="Red" BorderBrush="#111"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Page>
