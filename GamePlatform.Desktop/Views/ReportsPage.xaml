<Page x:Class="GamePlatform.Desktop.Views.ReportsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:conv="clr-namespace:GamePlatform.Desktop.Converters"
      Title="Zgłoszenia">
    <Page.Resources>
        <conv:ReportStatusConverter x:Key="ReportStatusConv"/>
        <!-- czarny przycisk -->
        <Style x:Key="BlackBtn" TargetType="Button"
               BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Width"       Value="80"/>
            <Setter Property="Padding"     Value="4 2"/>
            <Setter Property="Background"  Value="#111"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="BorderBrush" Value="#111"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </Page.Resources>
    <DockPanel Margin="12">
        <Button DockPanel.Dock="Top" Content="Odśwież" Width="100"
                Command="{Binding RefreshCommand}"
                Background="Black" Foreground="White" BorderBrush="Black"/>
        <DataGrid ItemsSource="{Binding Reports}" AutoGenerateColumns="False"
                  IsReadOnly="True" Margin="0 8 0 0">
            
            <DataGrid.Columns>
                <DataGridTextColumn Header="Data" Width="120" Binding="{Binding CreatedUtc}"/>
                <DataGridTextColumn Header="Zgłaszający" Width="120" Binding="{Binding Reporter.Login}"/>
                <DataGridTextColumn Header="Oskarżony" Width="120" Binding="{Binding ReportedUser.Login}"/>
                <DataGridTextColumn Header="Kategoria" Width="140" Binding="{Binding Category}"/>
                <DataGridTextColumn Header="Opis" Width="*" Binding="{Binding Description}"/>
                <DataGridTextColumn Header="Status" Width="100" Binding="{Binding Status, Converter={StaticResource ReportStatusConv}}"/>
                <DataGridTemplateColumn Header="AKCJE" Width="320">
                    <DataGridTemplateColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGridTemplateColumn.HeaderStyle>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource BlackBtn}" Content="Ostrzeż" Command="{Binding DataContext.WarnCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}"/>
                                <Button Style="{StaticResource BlackBtn}" Margin="8 0 0 0" Content="Anuluj" Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}"/>
                                <Button Style="{StaticResource BlackBtn}" Margin="8 0 0 0" Content="Zablokuj" Command="{Binding DataContext.BlockUserCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}"/>
                                <Button Style="{StaticResource BlackBtn}" Margin="8 0 0 0" Content="Usuń" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Page>
