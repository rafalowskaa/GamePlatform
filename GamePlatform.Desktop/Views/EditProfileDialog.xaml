<Window x:Class="GamePlatform.Desktop.Views.EditProfileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:loc="clr-namespace:GamePlatform.Desktop.Localization"
        Title="{loc:Loc EDIT_INFO}"
        Width="340"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource MaterialDesignWindow}">
    <StackPanel Margin="24" Width="300">
        <TextBox Text="{Binding NewLogin}" md:HintAssist.Hint="{loc:Loc LOGIN}"/>
        <TextBox Text="{Binding NewEmail}" Margin="0 8 0 0" md:HintAssist.Hint="{loc:Loc EMAIL}"/>
        <TextBox Text="{Binding RecoveryMail}" Margin="0 8 0 0" md:HintAssist.Hint="{loc:Loc RECOVERY_EMAIL}"/>
        <PasswordBox Margin="0 8 0 0" md:HintAssist.Hint="{loc:Loc NEW_PASSWORD}" PasswordChanged="OnPwdChanged"/>
        <Button Content="{loc:Loc CHANGE_PICTURE}" Margin="0 8 0 0"
                Background="Black" Foreground="White" BorderBrush="Black"
                Command="{Binding PickAvatarCommand}"
                HorizontalContentAlignment="Center"/>
        <TextBlock Text="{Binding Error}" Foreground="Red" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 16 0 0">
            <Button Content="{loc:Loc CANCEL}" IsCancel="True"
                    Background="Black" Foreground="White" BorderBrush="Black"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    HorizontalContentAlignment="Center"/>
            <Button Content="{loc:Loc SAVE}" Width="80" Margin="12 0 0 0"
                    Background="Black" Foreground="White" BorderBrush="Black"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Click="OnSaveClick" IsDefault="True"
                    HorizontalContentAlignment="Center"/>
        </StackPanel>
    </StackPanel>
</Window>