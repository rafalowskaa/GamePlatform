<UserControl x:Class="GamePlatform.Desktop.Views.FriendsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:models="clr-namespace:GamePlatform.Shared.Models;assembly=GamePlatform.Shared"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="Transparent"
             Width="300">

    <UserControl.Resources>
        <Style x:Key="ConversationItemStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Bd" Padding="6" CornerRadius="4"
                                Background="{TemplateBinding Background}"
                                BorderBrush="White" BorderThickness="0,0,0,1">
                        <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding HasUnread}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#77A8D9FF"/>
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard x:Name="UnreadBlinkStoryboard">
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                            <ColorAnimation Storyboard.TargetName="Bd"
                                                           Storyboard.TargetProperty="(Background).(SolidColorBrush.Color)"
                                                           From="#77A8D9FF" To="Transparent" Duration="0:0:0.6"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="UnreadBlinkStoryboard"/>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            
        </Style>
    </UserControl.Resources>



    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== WYSZUKIWANIE + PODPOWIEDZI ===== -->
        <StackPanel Margin="0 0 0 12" HorizontalAlignment="Center">
            <TextBox Width="240"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="OnSearchEnter"
                     md:HintAssist.Hint="Wprowadź nazwę użytkownika"/>

            <ListBox ItemsSource="{Binding Suggestions}"
                     Visibility="{Binding IsSuggestOpen, Converter={StaticResource BoolToVis}}"
                     Margin="0 4 0 0" Width="240" HorizontalAlignment="Center"
                     HorizontalContentAlignment="Stretch">

                <!-- ====== STYLE KONTENERA (podpowiedź) ====== -->
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <EventSetter Event="PreviewMouseLeftButtonUp"
                                     Handler="OnSuggestionItemClick"/>
                        <EventSetter Event="ContextMenuOpening"
                                     Handler="DisableContextMenu"/>
                        <Setter Property="ContextMenu">
                            <Setter.Value>
                                <ContextMenu>
                                    <MenuItem Header="{Binding PlacementTarget.DataContext.IsMyFriend,
                                                               Converter={StaticResource FriendAction},
                                                               RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              Command="{Binding ToggleForCommand}"
                                              CommandParameter="{Binding PlacementTarget.DataContext,
                                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <Separator/>
                                    <MenuItem Header="Napisz wiadomość"
                                              Command="{Binding StartChatCommand}"
                                              CommandParameter="{Binding PlacementTarget.DataContext,
                                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="Pokaż profil"
                                              Command="{Binding ShowProfileCommand}"
                                              CommandParameter="{Binding PlacementTarget.DataContext,
                                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <Separator/>
                                    <MenuItem Header="Zablokuj"
                                              Command="{Binding BlockCommand}"
                                              CommandParameter="{Binding PlacementTarget.DataContext,
                                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    <MenuItem Header="Zgłoś"
                                              Command="{Binding ReportCommand}"
                                              CommandParameter="{Binding PlacementTarget.DataContext,
                                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                </ContextMenu>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <!-- ====== SZABLON PODPOWIEDZI ====== -->
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:User}">
                        <Border Margin="0 1" Padding="4" Background="#444" CornerRadius="4">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                                <Ellipse Width="10" Height="10" Margin="0 0 6 0"
                                         Fill="{Binding IsOnline, Converter={StaticResource OnlineBrush}}"/>
                                <TextBlock Text="{Binding Login}" Foreground="White" Width="120"/>
                                
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <!-- ===== LISTA ROZMÓW, ZNAJOMYCH I ZABLOKOWANI ===== -->
        <StackPanel Grid.Row="1">
            <Border CornerRadius="6" Margin="0 0 0 8">
                <Expander Header="Rozmowy" IsExpanded="{Binding ChatsExpanded}"
                     Background="Black" Foreground="White">
                <ListView ItemsSource="{Binding Chats}"
                          
                          HorizontalContentAlignment="Stretch">
                    <ListView.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:User}">
                                <TextBlock Text="{Binding Login}" FontSize="16"/>
                            </DataTemplate>
                    </ListView.ItemTemplate>
                    <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource ConversationItemStyle}">
                                <EventSetter Event="PreviewMouseUp" Handler="OnChatItemClick"/>
                            <EventSetter Event="ContextMenuOpening" Handler="DisableContextMenu"/>
                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <ContextMenu>
                                        <MenuItem Header="{Binding PlacementTarget.DataContext.IsMyFriend, Converter={StaticResource FriendAction}, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  Command="{Binding ToggleForCommand}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <Separator/>
                                        <MenuItem Header="Napisz wiadomość" Command="{Binding StartChatCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <MenuItem Header="Pokaż profil" Command="{Binding ShowProfileCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <Separator/>
                                        <MenuItem Header="Zablokuj" Command="{Binding BlockCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <MenuItem Header="Zgłoś" Command="{Binding ReportCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    </ContextMenu>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </Expander>
            </Border>

            <Border CornerRadius="6" Margin="0 0 0 8">
                <Expander Header="Lista znajomych" IsExpanded="{Binding FriendsExpanded}"
                     Background="Black" Foreground="White">
                <ListView ItemsSource="{Binding Friends}"
                          SelectedItem="{Binding SelectedFriend}"
                          MouseDoubleClick="OnFriendOpen"
                          HorizontalContentAlignment="Stretch">

                    <!-- szablon -->
                    <ListView.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:User}">
                            <Border Margin="0 2" Padding="6" Background="#333" CornerRadius="4"
                                   BorderBrush="White" BorderThickness="0,0,0,1">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="10" Height="10" Margin="0 0 6 0"
                                                 Fill="{Binding IsOnline, Converter={StaticResource OnlineBrush}}"/>
                                        <TextBlock Text="{Binding Login}" FontSize="16" Foreground="White"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding IsOnline, Converter={StaticResource OnlineStatusText}}"
                                               FontSize="10"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>

                    <!-- kontener (LVItem) -->
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <EventSetter Event="PreviewMouseLeftButtonUp"
                                         Handler="OnFriendItemClick"/>
                            <EventSetter Event="ContextMenuOpening"
                                         Handler="DisableContextMenu"/>
                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <ContextMenu>
                                        <MenuItem Header="Usuń ze znajomych"
                                                  Command="{Binding ToggleForCommand}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext,
                                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <Separator/>
                                        <MenuItem Header="Napisz wiadomość"
                                                  Command="{Binding StartChatCommand}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext,
                                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <MenuItem Header="Pokaż profil"
                                                  Command="{Binding ShowProfileCommand}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext,
                                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <Separator/>
                                        <MenuItem Header="Zablokuj"
                                                  Command="{Binding BlockCommand}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext,
                                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <MenuItem Header="Zgłoś"
                                                  Command="{Binding ReportCommand}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext,
                                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    </ContextMenu>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </Expander>
            </Border>

            <Border CornerRadius="6" Margin="0">

                <Expander Header="Zablokowani"
                      
                      IsExpanded="{Binding BlockedExpanded}"
                      Background="Black" Foreground="White">
                <ListView ItemsSource="{Binding Blocked}"
                          HorizontalContentAlignment="Stretch">
                    <ListView.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:User}">
                            <Border Margin="0 2" Padding="6" Background="#333" CornerRadius="4"
                                   BorderBrush="White" BorderThickness="0,0,0,1">
                                <TextBlock Text="{Binding Login}" FontSize="16"/>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnBlockedItemClick"/>
                            <EventSetter Event="ContextMenuOpening" Handler="DisableContextMenu"/>
                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <ContextMenu>
                                        <MenuItem Header="Odblokuj" Command="{Binding UnblockCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    </ContextMenu>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </Expander>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
