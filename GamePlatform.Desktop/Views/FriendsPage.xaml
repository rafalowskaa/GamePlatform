<UserControl x:Class="GamePlatform.Desktop.Views.FriendsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="clr-namespace:GamePlatform.Desktop.ViewModels"
      xmlns:models="clr-namespace:GamePlatform.Shared.Models;assembly=GamePlatform.Shared"
      xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
      Background="Transparent">


    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== WYSZUKIWANIE ===== -->
        <StackPanel Margin="0 0 0 12" HorizontalAlignment="Center" Orientation="Horizontal">
            <TextBox Width="240"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="OnSearchEnter"
                     md:HintAssist.Hint="Wpisz nazwę poszukiwanego użytkownika"/>
        </StackPanel>

        <!-- ===== PODPOWIEDZI ===== -->
        <ListBox ItemsSource="{Binding Suggestions}"
                 Visibility="{Binding IsSuggestOpen, Converter={StaticResource BoolToVis}}"
                 MouseDoubleClick="OnSuggestionClick"
                 Margin="0 0 0 8" Width="240" HorizontalAlignment="Center"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="ContextMenu">
                        <Setter.Value>
                            <ContextMenu>
                                <MenuItem Header="Dodaj / Usuń"
                                          Command="{Binding DataContext.ToggleForCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                          CommandParameter="{Binding}"/>
                                <Separator/>
                                <MenuItem Header="Napisz wiadomość"
                                          Command="{Binding DataContext.StartChatCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                          CommandParameter="{Binding}"/>
                                <MenuItem Header="Pokaż profil"
                                          Command="{Binding DataContext.ShowProfileCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                          CommandParameter="{Binding}"/>
                                <Separator/>
                                <MenuItem Header="Zablokuj"
                                          Command="{Binding DataContext.BlockCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                          CommandParameter="{Binding}"/>
                                <MenuItem Header="Zgłoś"
                                          Command="{Binding DataContext.ReportCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                          CommandParameter="{Binding}"/>
                            </ContextMenu>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type models:User}">
                    <Border Margin="0 1" Padding="4" Background="#444" CornerRadius="4">
                        <TextBlock Text="{Binding Login}" Foreground="White"/>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- ===== LISTA ===== -->
        <ListView Grid.Row="1"
                  ItemsSource="{Binding Friends}"
                  SelectedItem="{Binding SelectedFriend}"
                  HorizontalContentAlignment="Stretch">
            <ListView.ItemTemplate>
                <DataTemplate DataType="{x:Type models:User}">
                    <Border Margin="0 2" Padding="6" Background="#333" CornerRadius="4">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left"
                                       Text="{Binding Login}"
                                       FontSize="16" Foreground="White"/>

                            <Button DockPanel.Dock="Right"
                                    Style="{StaticResource MaterialDesignIconButton}">
                                <Button.Content>
                                    <Path Data="M0,0 3,0 3,3 0,3Z M6,0 9,0 9,3 6,3Z M12,0 15,0 15,3 12,3Z"
                                          Fill="White" Stretch="Uniform"/>
                                </Button.Content>

                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Dodaj / Usuń"
                                                  Command="{Binding DataContext.ToggleFriendAsyncCommand,
                                                      RelativeSource={RelativeSource AncestorType=ListView}}"
                                                  CommandParameter="{Binding}"/>
                                        <Separator/>
                                        <MenuItem Header="Napisz wiadomość"
                                                  Command="{Binding DataContext.StartChatCommand,
                                                      RelativeSource={RelativeSource AncestorType=ListView}}"
                                                  CommandParameter="{Binding}"/>
                                        <MenuItem Header="Pokaż profil"
                                                  Command="{Binding DataContext.ShowProfileCommand,
                                                      RelativeSource={RelativeSource AncestorType=ListView}}"
                                                  CommandParameter="{Binding}"/>
                                        <Separator/>
                                        <MenuItem Header="Zablokuj"
                                                  Command="{Binding DataContext.BlockCommand,
                                                      RelativeSource={RelativeSource AncestorType=ListView}}"
                                                  CommandParameter="{Binding}"/>
                                        <MenuItem Header="Zgłoś"
                                                  Command="{Binding DataContext.ReportCommand,
                                                      RelativeSource={RelativeSource AncestorType=ListView}}"
                                                  CommandParameter="{Binding}"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
