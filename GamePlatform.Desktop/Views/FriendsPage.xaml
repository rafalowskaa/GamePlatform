<UserControl x:Class="GamePlatform.Desktop.Views.FriendsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:models="clr-namespace:GamePlatform.Shared.Models;assembly=GamePlatform.Shared"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:loc="clr-namespace:GamePlatform.Desktop.Localization"
             Background="Transparent"
             Width="240">

    <!-- ═════════════  R E S O U R C E S  ═════════════ -->
    <UserControl.Resources>

        <!-- Pusty avatar -->
        <BitmapImage x:Key="EmptyAvatar" UriSource="pack://application:,,,/Resources/avatar_empty.png"/>

        <!-- ==== STYLOWANIE ==== -->
        <!-- Nagłówki sekcji -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding"    Value="6 0 0 2"/>
        </Style>

        <!-- ListViewItem z miganiem -->
        <Style x:Key="ConversationItemStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin"  Value="0 1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#333"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding HasUnread}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard x:Name="BlinkSB">
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                            <ColorAnimation Storyboard.TargetName="Bd"
                                                            Storyboard.TargetProperty="(Background).(SolidColorBrush.Color)"
                                                            From="#44A8D9FF" To="Transparent" Duration="0:0:0.45"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="BlinkSB"/>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Bd"
                                                            Storyboard.TargetProperty="(Background).(SolidColorBrush.Color)"
                                                            To="Transparent" Duration="0"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Avatar + nazwa + ostatnia wiadomość -->
        <DataTemplate x:Key="ChatItemTemplate" DataType="{x:Type models:User}">
            <Grid Margin="0 2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Avatar -->
                <Border Width="40" Height="40" CornerRadius="20" ClipToBounds="True">
                    <Image Source="{Binding AvatarPath, Converter={StaticResource AvatarConverter}, TargetNullValue={StaticResource EmptyAvatar}}"
                           Stretch="UniformToFill"/>
                </Border>

                <!-- Tekst -->
                <StackPanel Grid.Column="1" Margin="8 0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Login}" Foreground="White"
                               FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock Text="{Binding LastMessage}"
                               Foreground="#bbb" FontSize="11"
                               TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                </StackPanel>

                <!-- Kropka online -->
                <Ellipse Width="10" Height="10" Fill="{Binding IsOnline, Converter={StaticResource OnlineBrush}}"
                         Stroke="#202020" StrokeThickness="1"
                         HorizontalAlignment="Left" VerticalAlignment="Bottom"
                         Margin="28 0 0 4"/>
            </Grid>
        </DataTemplate>

        <!-- Avatar + nazwa (lista znajomych) -->
        <DataTemplate x:Key="FriendItemTemplate" DataType="{x:Type models:User}">
            <Grid Margin="0 2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="20" ClipToBounds="True">
                    <Image Source="{Binding AvatarPath, Converter={StaticResource AvatarConverter}, TargetNullValue={StaticResource EmptyAvatar}}"
                           Stretch="UniformToFill"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="8 0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Login}" Foreground="White"
                               FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock Text="{Binding IsOnline, Converter={StaticResource OnlineStatusText}}"
                               FontSize="10" Foreground="#999"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Blokada -->
        <DataTemplate x:Key="BlockedItemTemplate" DataType="{x:Type models:User}">
            <Grid Margin="0 2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="20" ClipToBounds="True">
                    <Image Source="{Binding AvatarPath, Converter={StaticResource AvatarConverter}, TargetNullValue={StaticResource EmptyAvatar}}"
                           Stretch="UniformToFill" Opacity="0.3"/>
                </Border>
                <TextBlock Grid.Column="1" Margin="8 0" VerticalAlignment="Center"
                           Text="{Binding Login}" Foreground="#ccc" FontSize="13"/>
            </Grid>
        </DataTemplate>

        <!-- Styl wszystkich ListView -->
        <Style TargetType="ListView">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background"      Value="Transparent"/>
        </Style>

    </UserControl.Resources>

    <!-- ═════════════  L A Y O U T  ═════════════ -->
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Listy -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== SZUKAJ GRACZA + SUGESTIE ===== -->
        <StackPanel Grid.Row="0" Margin="0 0 0 14" HorizontalAlignment="Center">
            <TextBox Width="240"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="OnSearchEnter"
                     md:HintAssist.Hint="{loc:Loc SEARCH_PLAYER}"
                     Background="#222" Foreground="White" BorderBrush="#444"
                     TextAlignment="Left" HorizontalContentAlignment="Left"/>

            <ListBox ItemsSource="{Binding Suggestions}"
                     Visibility="{Binding IsSuggestOpen, Converter={StaticResource BoolToVis}}"
                     Margin="0 4 0 0" Width="240"
                     Background="#333" BorderBrush="#444"
                     HorizontalContentAlignment="Stretch">

                <!-- kontener podpowiedzi -->
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnSuggestionItemClick"/>
                        <EventSetter Event="ContextMenuOpening"      Handler="DisableContextMenu"/>
                    </Style>
                </ListBox.ItemContainerStyle>

                <!-- szablon podpowiedzi -->
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:User}">
                        <StackPanel Orientation="Horizontal" Margin="4 2">
                            <Ellipse Width="10" Height="10" Margin="0 0 6 0"
                                     Fill="{Binding IsOnline, Converter={StaticResource OnlineBrush}}"/>
                            <TextBlock Text="{Binding Login}" Foreground="White"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <!-- ===== 3) LISTY: Rozmowy / Znajomi / Zablokowani ===== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- ROZMOWY -->
                <TextBlock Text="{loc:Loc CONVERSATIONS}" Style="{StaticResource SectionHeader}"/>
                <ListView ItemsSource="{Binding Chats}"
                          ItemTemplate="{StaticResource ChatItemTemplate}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource ConversationItemStyle}">
                            <EventSetter Event="PreviewMouseUp"        Handler="OnChatItemClick"/>
                            <EventSetter Event="ContextMenuOpening"    Handler="DisableContextMenu"/>
                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <ContextMenu>
                                        <MenuItem Header="{Binding PlacementTarget.DataContext.IsMyFriend,
                                                           Converter={StaticResource FriendAction},
                                                           RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  Command="{Binding ToggleForCommand}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext,
                                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <Separator/>
                                        <MenuItem Header="{loc:Loc WRITE_MSG}"
                                                  Command="{Binding StartChatCommand}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext,
                                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <MenuItem Header="{loc:Loc SHOW_PROFILE}"
                                                  Command="{Binding ShowProfileCommand}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext,
                                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <Separator/>
                                        <MenuItem Header="{loc:Loc BLOCK}"
                                                  Command="{Binding BlockCommand}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext,
                                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <MenuItem Header="{loc:Loc REPORT}"
                                                  Command="{Binding ReportCommand}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext,
                                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    </ContextMenu>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>

                <!-- ZNAJOMI -->
                <TextBlock Text="{loc:Loc FRIENDS}" Style="{StaticResource SectionHeader}" Margin="0 8 0 0"/>
                <ListView ItemsSource="{Binding Friends}"
                          ItemTemplate="{StaticResource FriendItemTemplate}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnFriendItemClick"/>
                            <EventSetter Event="ContextMenuOpening"      Handler="DisableContextMenu"/>
                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <ContextMenu>
                                        <MenuItem Header="{loc:Loc REMOVE_FRIEND}"
                                                  Command="{Binding ToggleForCommand}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext,
                                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <Separator/>
                                        <MenuItem Header="{loc:Loc WRITE_MSG}"
                                                  Command="{Binding StartChatCommand}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext,
                                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <MenuItem Header="{loc:Loc SHOW_PROFILE}"
                                                  Command="{Binding ShowProfileCommand}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext,
                                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <Separator/>
                                        <MenuItem Header="{loc:Loc BLOCK}"
                                                  Command="{Binding BlockCommand}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext,
                                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <MenuItem Header="{loc:Loc REPORT}"
                                                  Command="{Binding ReportCommand}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext,
                                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    </ContextMenu>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>

                <!-- ZABLOKOWANI -->
                <TextBlock Text="{loc:Loc BLOCKED}" Style="{StaticResource SectionHeader}" Margin="0 8 0 0"/>
                <ListView ItemsSource="{Binding Blocked}"
                          ItemTemplate="{StaticResource BlockedItemTemplate}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnBlockedItemClick"/>
                            <EventSetter Event="ContextMenuOpening"      Handler="DisableContextMenu"/>
                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <ContextMenu>
                                        <MenuItem Header="{loc:Loc UNBLOCK}"
                                                  Command="{Binding UnblockCommand}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext,
                                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    </ContextMenu>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
