<UserControl x:Class="GamePlatform.Desktop.Views.FriendsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="clr-namespace:GamePlatform.Desktop.ViewModels"
      xmlns:models="clr-namespace:GamePlatform.Shared.Models;assembly=GamePlatform.Shared"
      xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
      Background="Transparent"
      Width="300">



    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== WYSZUKIWANIE + PODPOWIEDZI ===== -->
        <StackPanel Margin="0 0 0 12" HorizontalAlignment="Center">
            <TextBox Width="240"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="OnSearchEnter"
                     md:HintAssist.Hint="Wprowadź nazwę użytkownika"/>
            <ListBox ItemsSource="{Binding Suggestions}"
                     Visibility="{Binding IsSuggestOpen, Converter={StaticResource BoolToVis}}"
                     Margin="0 4 0 0" Width="240" HorizontalAlignment="Center"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                        <EventSetter Event="MouseLeftButtonUp" Handler="OnSuggestionItemClick"/>
                        <Setter Property="ContextMenu">
                        <Setter.Value>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="{Binding IsMyFriend, Converter={StaticResource FriendAction}}"
                                          Command="{Binding DataContext.ToggleForCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                          CommandParameter="{Binding}"/>
                                <Separator/>
                                <MenuItem Header="Napisz wiadomość"
                                          Command="{Binding DataContext.StartChatCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                          CommandParameter="{Binding}"/>
                                <MenuItem Header="Pokaż profil"
                                          Command="{Binding DataContext.ShowProfileCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                          CommandParameter="{Binding}"/>
                                <Separator/>
                                <MenuItem Header="Zablokuj"
                                          Command="{Binding DataContext.BlockCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                          CommandParameter="{Binding}"/>
                                <MenuItem Header="Zgłoś"
                                          Command="{Binding DataContext.ReportCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                          CommandParameter="{Binding}"/>
                            </ContextMenu>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:User}">
                        <Border Margin="0 1" Padding="4" Background="#444" CornerRadius="4">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="10" Height="10" Margin="0 0 6 0"
                                     Fill="{Binding IsOnline, Converter={StaticResource OnlineBrush}}"/>
                            <TextBlock Text="{Binding Login}" Foreground="White"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        </StackPanel>

        <!-- ===== LISTA ===== -->
        <StackPanel Grid.Row="1">
            <Expander Header="Lista znajomych" IsExpanded="{Binding FriendsExpanded}">
                <ListView ItemsSource="{Binding Friends}"
                          SelectedItem="{Binding SelectedFriend}"
                          MouseDoubleClick="OnFriendOpen"
                          HorizontalContentAlignment="Stretch">
                    <ListView.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:User}">
                            <Border Margin="0 2" Padding="6" Background="#333" CornerRadius="4">
                                <StackPanel Orientation="Vertical">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="10" Height="10" Margin="0 0 6 0"
                                                 Fill="{Binding IsOnline, Converter={StaticResource OnlineBrush}}"/>
                                        <TextBlock Text="{Binding Login}" FontSize="16" Foreground="White"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding IsOnline, Converter={StaticResource OnlineStatusText}}" FontSize="10"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <EventSetter Event="MouseLeftButtonUp" Handler="OnFriendItemClick"/>
                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="Usuń ze znajomych"
                                                  Command="{Binding DataContext.ToggleForCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                  CommandParameter="{Binding}"/>
                                        <Separator/>
                                        <MenuItem Header="Napisz wiadomość"
                                                  Command="{Binding DataContext.StartChatCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                  CommandParameter="{Binding}"/>
                                        <MenuItem Header="Pokaż profil"
                                                  Command="{Binding DataContext.ShowProfileCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                  CommandParameter="{Binding}"/>
                                        <Separator/>
                                        <MenuItem Header="Zablokuj"
                                                  Command="{Binding DataContext.BlockCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                  CommandParameter="{Binding}"/>
                                        <MenuItem Header="Zgłoś"
                                                  Command="{Binding DataContext.ReportCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                  CommandParameter="{Binding}"/>
                                    </ContextMenu>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </Expander>

            <Expander Header="Zablokowani" Margin="0 8 0 0" IsExpanded="{Binding BlockedExpanded}">
                <ListView ItemsSource="{Binding Blocked}" HorizontalContentAlignment="Stretch">
                    <ListView.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:User}">
                            <Border Margin="0 2" Padding="6" Background="#333" CornerRadius="4">
                                <TextBlock Text="{Binding Login}" FontSize="16"/>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Expander>
        </StackPanel>
    </Grid>
</UserControl>
