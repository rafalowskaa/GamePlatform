<Page x:Class="GamePlatform.Desktop.Views.FriendsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">

    <DockPanel Margin="24">

        <!-- ░░ WYSZUKIWANIE ░░ -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
            <ComboBox Width="260"
                      Text="{Binding SearchText,UpdateSourceTrigger=PropertyChanged}"
                      ItemsSource="{Binding Suggestions}"
                      DisplayMemberPath="Login"
                      IsEditable="True"
                      IsDropDownOpen="{Binding IsSuggestOpen}"
                      KeyDown="OnKey">
                <ComboBox.ItemContainerStyle>
                    <Style TargetType="ComboBoxItem">
                        <EventSetter Event="PreviewMouseLeftButtonUp"
                                     Handler="OnSuggestPicked"/>
                    </Style>
                </ComboBox.ItemContainerStyle>
            </ComboBox>

            <Button Content="Szukaj" Background="Black" Foreground="White" BorderBrush="Black"
                    Margin="8 0 0 0"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Command="{Binding InviteCommand}"/>
        </StackPanel>

        <!-- ░░ LISTA ZNAJOMYCH ░░ -->
        <ListView ItemsSource="{Binding Friends}" Margin="0 12 0 0">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Login}" Width="140"/>
                        <TextBlock Text="{Binding Email}" Width="220"/>

                        <Button Content="⋯" Width="32" Padding="0">
                            <Button.ContextMenu>
                                <ContextMenu>

                                    <MenuItem Header="Wyświetl profil"
                                              Command="{Binding DataContext.ViewProfileCommand,
                                                                RelativeSource={RelativeSource AncestorType=Page}}"
                                              CommandParameter="{Binding}"/>

                                    <MenuItem Header="Usuń ze znajomych"
                                              Command="{Binding DataContext.RemoveCommand,
                                                                RelativeSource={RelativeSource AncestorType=Page}}"
                                              CommandParameter="{Binding}"/>

                                    <Separator/>

                                    <MenuItem Header="Zablokuj"
                                              Command="{Binding DataContext.BlockCommand,
                                                                RelativeSource={RelativeSource AncestorType=Page}}"
                                              CommandParameter="{Binding}"/>

                                    <MenuItem Header="Odblokuj"
                                              Command="{Binding DataContext.UnblockCommand,
                                                                RelativeSource={RelativeSource AncestorType=Page}}"
                                              CommandParameter="{Binding}"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- globalny Snackbar -->
        <md:Snackbar DockPanel.Dock="Bottom"
                     MessageQueue="{DynamicResource GlobalMsgQueue}"/>
    </DockPanel>
</Page>
