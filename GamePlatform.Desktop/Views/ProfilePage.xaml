<Page x:Class="GamePlatform.Desktop.Views.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:conv="clr-namespace:GamePlatform.Desktop.Converters"
      xmlns:models="clr-namespace:GamePlatform.Shared.Models;assembly=GamePlatform.Shared"
      xmlns:loc="clr-namespace:GamePlatform.Desktop.Localization">

    <Page.Resources>
        <conv:CoverImageConverter x:Key="CoverConv"/>
        <conv:RankToTrophyConverter x:Key="RankTrophyConv"/>
    </Page.Resources>

    <Grid Margin="24" VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel>
            <Border Width="100" Height="100" CornerRadius="50" Background="#333" AllowDrop="True" Drop="OnAvatarDrop">
                <Image Source="{Binding Avatar}" Stretch="UniformToFill" ClipToBounds="True"/>
            </Border>
            <Button Content="{loc:Loc CHANGE_PICTURE}" Background="Black" Foreground="White" BorderBrush="Black"
                    Margin="0 8 0 0"
                    Command="{Binding PickAvatarCommand}" Width="100"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Width="260">
            <TextBox Text="{Binding NewLogin}"        md:HintAssist.Hint="{loc:Loc LOGIN}"/>
            <TextBox Text="{Binding NewEmail}"        md:HintAssist.Hint="{loc:Loc EMAIL}"        Margin="0 8 0 0"/>
            <TextBox Text="{Binding RecoveryMail}"    md:HintAssist.Hint="{loc:Loc RECOVERY_EMAIL}" Margin="0 8 0 0"/>

            <PasswordBox md:HintAssist.Hint="{loc:Loc NEW_PASSWORD}"
                         Margin="0 8 0 0"
                         PasswordChanged="PwdChanged"/>

            <TextBlock Text="{Binding Error}" Foreground="Red" TextWrapping="Wrap"/>

            <Button Content="{loc:Loc SAVE}" Background="Black" Foreground="White" BorderBrush="Black"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Command="{Binding SaveCommand}"
                    Margin="0 12 0 0"
                    IsDefault="True"/>

            <StackPanel Orientation="Horizontal" Margin="0 12 0 0" VerticalAlignment="Center">
                <ProgressBar Minimum="0" Maximum="{Binding NextXp}" Value="{Binding CurrentXp}" Height="20" Width="200"/>
                <Image Height="20" Width="20" Margin="8 0 0 0"
                       Source="{Binding Rank, Converter={StaticResource RankTrophyConv}}"/>
            </StackPanel>
            <TextBlock Text="{Binding Rank}" HorizontalAlignment="Center" Margin="0 4 0 12"/>

            <TextBlock Text="{loc:Loc FAVORITE_GAMES}" FontWeight="Bold" Margin="0 20 0 4"/>
            <ItemsControl ItemsSource="{Binding Favorites}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:Game}">
                        <Border Width="200" Height="300" Margin="4" BorderBrush="Gray" BorderThickness="1">
                            <StackPanel>
                                <Image Height="220" Width="200" Stretch="UniformToFill"
                                       Source="{Binding Versions[0].FolderPath, Converter={StaticResource CoverConv}}"/>
                                <TextBlock Text="{Binding Title}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding LastPlayed}" FontSize="10" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding PlaytimeSeconds}" FontSize="10" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding HighestScore}" FontSize="10" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Grid>
</Page>
