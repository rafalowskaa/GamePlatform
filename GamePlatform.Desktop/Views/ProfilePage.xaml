<Page x:Class="GamePlatform.Desktop.Views.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:conv="clr-namespace:GamePlatform.Desktop.Converters"
      xmlns:loc="clr-namespace:GamePlatform.Desktop.Localization">

    <Page.Resources>
        <conv:CoverImageConverter x:Key="CoverConv"/>
        <conv:RankToTrophyConverter x:Key="RankTrophyConv"/>
    </Page.Resources>

    <Grid Margin="24" Background="#303030">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- avatar, name and edit button -->
        <StackPanel Orientation="Horizontal">
            <StackPanel>
                <Border Width="96" Height="96" CornerRadius="48" Background="#333">
                    <Image Source="{Binding Avatar}" Stretch="UniformToFill" ClipToBounds="True"/>
                </Border>
                <Button Content="{loc:Loc EDIT_INFO}" Width="96" Margin="0 4 0 0"
                        Background="Black" Foreground="White" BorderBrush="Black"
                        Command="{Binding EditInfoCommand}"
                        HorizontalContentAlignment="Center"/>
            </StackPanel>
            <StackPanel Margin="12 0 0 0" VerticalAlignment="Center" Height="96">
                <TextBlock Text="{Binding NewLogin}" FontSize="20" FontWeight="Bold" Foreground="White"/>
                <StackPanel Orientation="Horizontal" Margin="0 4 0 0" VerticalAlignment="Center">
                    <Image Width="20" Height="20" Source="{Binding RankEnum, Converter={StaticResource RankTrophyConv}}"/>
                    <TextBlock Text="{Binding Rank}" Margin="4 0 0 0" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- xp bar -->
        <Grid Grid.Row="1" Margin="0 16 0 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Image Grid.Column="0" Width="32" Height="32" Source="{Binding RankEnum, Converter={StaticResource RankTrophyConv}}"/>
            <ProgressBar Grid.Column="1" Minimum="0" Maximum="{Binding NextXp}" Value="{Binding CurrentXp, Mode=OneWay}"
                         Height="24" Foreground="#7c80ff" Background="#555"/>
            <Image Grid.Column="2" Width="32" Height="32" Source="{Binding NextRankEnum, Converter={StaticResource RankTrophyConv}}"/>
        </Grid>
        <TextBlock Grid.Row="1" Margin="0 42 0 0" HorizontalAlignment="Center" Foreground="White">
            <Run Text="{Binding CurrentXp}"/><Run Text=" / "/><Run Text="{Binding NextXp}"/>
            <Run Text=" "/><Run Text="{loc:Loc TO_NEXT}"/>
        </TextBlock>

        <!-- favorites header -->
        <TextBlock Grid.Row="2" Text="{loc:Loc FAVORITE_GAMES}" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0 16 0 4"/>

        <!-- favorites table -->
        <DataGrid Grid.Row="3" ItemsSource="{Binding Favorites}" AutoGenerateColumns="False" IsReadOnly="True"
                  Margin="0 20 0 0" Background="#303030" Foreground="White" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="50">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Width="40" Height="40" Stretch="UniformToFill" Source="{Binding Versions[0].FolderPath, Converter={StaticResource CoverConv}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{loc:Loc TITLE}" Binding="{Binding Title}" Width="*"/>
                <DataGridTextColumn Header="{loc:Loc LAST_PLAYED}" Binding="{Binding LastPlayed}" Width="120"/>
                <DataGridTextColumn Header="{loc:Loc PLAY_TIME}" Binding="{Binding PlaytimeSeconds}" Width="100"/>
                <DataGridTextColumn Header="{loc:Loc HIGHEST_SCORE}" Binding="{Binding HighestScore}" Width="120"/>
                <DataGridTemplateColumn Header="" Width="180">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="{loc:Loc PLAY}" Width="90" Margin="0 0 8 0"
                                        Background="Black" Foreground="White" BorderBrush="Black"
                                        Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                        CommandParameter="{Binding}"
                                        HorizontalContentAlignment="Center"/>
                                <Button Content="{loc:Loc REMOVE_FROM_FAVORITES}" Width="90"
                                        Background="Black" Foreground="White" BorderBrush="Black"
                                        Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                        CommandParameter="{Binding}"
                                        HorizontalContentAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>