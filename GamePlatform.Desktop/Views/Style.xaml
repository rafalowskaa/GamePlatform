<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="TabBlue">#0D3A71</Color>
    <Color x:Key="TabBlueActive">#1F5FFF</Color>
    <Color x:Key="TabBlueAdmin">#061C3D</Color>

    <SolidColorBrush x:Key="TabBlueBrush" Color="{StaticResource TabBlue}"/>
    <SolidColorBrush x:Key="TabBlueActiveBrush" Color="{StaticResource TabBlueActive}"/>
    <SolidColorBrush x:Key="TabBlueAdminBrush" Color="{StaticResource TabBlueAdmin}"/>

    <Style x:Key="MainTabItemStyle" TargetType="TabItem">
        <Setter Property="Background" Value="{StaticResource TabBlueBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="MinWidth" Value="100"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="12 4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"
                                          TextBlock.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="Background.(SolidColorBrush.Color)" To="{StaticResource TabBlueActive}" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource TabBlueActiveBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="False">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="Background.(SolidColorBrush.Color)" To="{StaticResource TabBlue}" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- darker tabs used for admin only sections -->
    <Style x:Key="AdminTabItemStyle" TargetType="TabItem" BasedOn="{StaticResource MainTabItemStyle}">
        <Setter Property="Background" Value="{StaticResource TabBlueAdminBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"
                                          TextBlock.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="Background.(SolidColorBrush.Color)" To="{StaticResource TabBlueActive}" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource TabBlueActiveBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="False">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="Background.(SolidColorBrush.Color)" To="{StaticResource TabBlueAdmin}" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- navigation button styled like tabs (used for logout) -->
    <Style x:Key="NavBtn" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
        <Setter Property="Padding" Value="12 4"/>
        <Setter Property="Background" Value="{StaticResource TabBlueBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="MinWidth" Value="100"/>
    </Style>
</ResourceDictionary>