<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  █████  ZAKŁADKI  █████  -->

    <!-- podstawowy jasnoniebieski -->
    <Style x:Key="MainTabItemStyle"
           TargetType="TabItem">
        <Setter Property="Background"       Value="#0d3a71"/>
        <!-- podstawowy -->
        <Setter Property="Foreground"       Value="White"/>
        <Setter Property="MinWidth"         Value="100"/>
        <Setter Property="Height"           Value="36"/>
        <Setter Property="BorderThickness"  Value="0"/>
        <Setter Property="Padding"          Value="12 4"/>

        <!-- animacja i pogrubienie po zaznaczeniu -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!-- aktywna zakładka -->
                        <Trigger Property="IsSelected" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Bd"
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="#1F5FFF" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>

                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter TargetName="Bd" Property="Background" Value="#1F5FFF"/>
                        </Trigger>

                        <!-- powrót do normalnego koloru -->
                        <Trigger Property="IsSelected" Value="False">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Bd"
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="#0d3a71" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ciemniejsze tło – tylko dla sekcji administracyjnych -->
    <Style x:Key="AdminTabItemStyle"
           TargetType="TabItem"
           BasedOn="{StaticResource MainTabItemStyle}">
        <Setter Property="Background" Value="#082554"/>
    </Style>


    <!--  █████  PRZYCISK NAWIGACYJNY  (Wyloguj)  █████  -->

    <Style x:Key="NavBtn"
           TargetType="Button"
           BasedOn="{StaticResource MaterialDesignFlatButton}">
        <Setter Property="Padding"    Value="12 4"/>
        <Setter Property="Background" Value="#0d3a71"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="MinWidth"   Value="100"/>
        <Setter Property="Height"     Value="36"/>
        <!-- zachowanie „tab-like” przy najechaniu -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1F5FFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
