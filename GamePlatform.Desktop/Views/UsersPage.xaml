<Page x:Class="GamePlatform.Desktop.Views.UsersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:enums="clr-namespace:GamePlatform.Shared.Enums;assembly=GamePlatform.Shared"
      xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Grid Margin="24">
        <DataGrid ItemsSource="{Binding Users}"
                  AutoGenerateColumns="False"
                  md:DataGridAssist.CellPadding="4"
                  RowHeaderWidth="0">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Login" Binding="{Binding Login, Mode=TwoWay}"/>
                <DataGridTextColumn Header="Email" Binding="{Binding Email, Mode=TwoWay}" Width="2*"/>

                <DataGridTemplateColumn Header="Rola" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{x:Static enums:EnumExtensions.RoleValues}"
                                      SelectedItem="{Binding Role, Mode=TwoWay}"
                                      Width="90"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Blokada do"
                                    Binding="{Binding BlockedUntilUtc, Mode=TwoWay}"
                                    Width="120"/>
                <DataGridTextColumn Header="Powód"
                                    Binding="{Binding BlockReason, Mode=TwoWay}"
                                    Width="160"/>
                <DataGridTextColumn Header="Ostatnie log."
                                    Binding="{Binding LastLoginUtc}"
                                    Width="130"/>

                <DataGridTemplateColumn Header="Akcje" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Zapisz"
                                        Command="{Binding DataContext.SaveCommand,
                                                  RelativeSource={RelativeSource AncestorType=Page}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource MaterialDesignFlatButton}"/>
                                <Button Content="Usuń" Margin="8 0 0 0"
                                        Command="{Binding DataContext.DeleteCommand,
                                                  RelativeSource={RelativeSource AncestorType=Page}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource MaterialDesignFlatButton}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
