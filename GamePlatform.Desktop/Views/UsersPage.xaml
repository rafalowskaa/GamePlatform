<Page x:Class="GamePlatform.Desktop.Views.UsersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ==========  ZASOBY  ========== -->
    <Page.Resources>

        <!-- nagłówek kolumny -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Foreground"   Value="White"/>
            <Setter Property="Background"   Value="#222"/>
            <Setter Property="BorderBrush"  Value="#444"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
        </Style>

        <!-- wiersz -->
        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#444"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- wyśrodkowany TextBlock -->
        <Style x:Key="CenterTxt" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
            <Setter Property="TextAlignment"       Value="Center"/>
            <Setter Property="TextTrimming"        Value="CharacterEllipsis"/>
        </Style>

        <!-- czarny przycisk -->
        <Style x:Key="BlackBtn" TargetType="Button"
               BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Width"       Value="140"/>
            <Setter Property="Padding"     Value="4 2"/>
            <Setter Property="Background"  Value="#111"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="BorderBrush" Value="#111"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- tooltip – ciemny -->
        <Style x:Key="DarkToolTip" TargetType="ToolTip">
            <Setter Property="Background"  Value="#111"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="Padding"     Value="6"/>
            <Setter Property="BorderBrush" Value="#111"/>
        </Style>

        <!-- ☁ widoczna tylko gdy BlockReason nie jest pusty -->
        <Style x:Key="CloudVisibilityStyle" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <!-- null -->
                <DataTrigger Binding="{Binding BlockReason}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <!-- pusty string -->
                <DataTrigger Binding="{Binding BlockReason.Length}" Value="0">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </Page.Resources>

    <!-- ==========  KONTENER GŁÓWNY  ========== -->
    <DockPanel Margin="12">

        <!-- ═══════  FILTRY  ═══════ -->
        <StackPanel Orientation="Horizontal" Margin="0 0 0 6" DockPanel.Dock="Top">

            <!-- Rola -->
            <TextBlock Text="Rola:" Foreground="White"
                       VerticalAlignment="Center" Margin="0 0 4 0"/>
            <ComboBox ItemsSource="{Binding Roles}"
                      SelectedItem="{Binding SelectedRoleFilter}"
                      Width="120" Margin="0 0 12 0"/>

            <!-- Login -->
            <TextBlock Text="Login:" Foreground="White"
                       VerticalAlignment="Center" Margin="0 0 4 0"/>
            <TextBox Text="{Binding LoginFilter, UpdateSourceTrigger=PropertyChanged}"
                     Width="160" Margin="0 0 12 0"/>

            <!-- tylko z blokadą -->
            <CheckBox Content="Tylko z blokadą"
                      IsChecked="{Binding OnlyBlocked}"
                      Foreground="White" Margin="0 0 12 0"/>

            <!-- wyczyść -->
            <Button Content="Wyczyść"
                    Style="{StaticResource BlackBtn}"
                    Command="{Binding ClearFiltersCommand}"/>
        </StackPanel>

        <!-- ==========  DATA-GRID  ========== -->
        <DataGrid ItemsSource="{Binding UsersView}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="None"
                  RowHeaderWidth="0"
                  CanUserResizeColumns="False"
                  CanUserResizeRows="False"
                  CanUserSortColumns="True"
                  Background="Transparent"
                  BorderThickness="0">

            <DataGrid.Columns>

                <!-- LOGIN -->
                <DataGridTextColumn Header="LOGIN" Width="*"
                                    SortMemberPath="Login"
                                    Binding="{Binding Login}"
                                    ElementStyle="{StaticResource CenterTxt}"/>

                <!-- ROLA -->
                <DataGridTextColumn Header="ROLA" Width="110"
                                    SortMemberPath="Role"
                                    Binding="{Binding Role}"
                                    ElementStyle="{StaticResource CenterTxt}"/>

                <!-- BLOKADA + ☁ -->
                <DataGridTemplateColumn Header="BLOKADA" Width="220"
                                        SortMemberPath="BlockedUntilUtc">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center">

                                <TextBlock Style="{StaticResource CenterTxt}"
                                           Width="160"
                                           Text="{Binding BlockedUntilUtc}"/>

                                <TextBlock Text="☁"
                                           FontSize="14"
                                           Margin="4 0 0 0"
                                           Style="{StaticResource CloudVisibilityStyle}">
                                    <TextBlock.ToolTip>
                                        <ToolTip Style="{StaticResource DarkToolTip}"
                                                 Content="{Binding BlockReason}" />
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- OSTATNIE LOG. -->
                <DataGridTextColumn Header="OSTATNIE LOGOWANIE" Width="180"
                                    SortMemberPath="LastLoginUtc"
                                    Binding="{Binding LastLoginUtc}"
                                    ElementStyle="{StaticResource CenterTxt}"/>

                <!-- AKCJE -->
                <DataGridTemplateColumn Header="AKCJE" Width="320">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center">
                                <Button Style="{StaticResource BlackBtn}"
                                        Content="EDYTUJ"
                                        Command="{Binding DataContext.EditCommand,
                                                  RelativeSource={RelativeSource AncestorType=Page}}"
                                        CommandParameter="{Binding}"/>

                                <Button Style="{StaticResource BlackBtn}"
                                        Margin="8 0 0 0"
                                        Content="USUŃ UŻYTKOWNIKA"
                                        Command="{Binding DataContext.DeleteCommand,
                                                  RelativeSource={RelativeSource AncestorType=Page}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>
</Page>
