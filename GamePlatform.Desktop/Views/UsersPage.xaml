<Page x:Class="GamePlatform.Desktop.Views.UsersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Grid Margin="24">
        <DataGrid ItemsSource="{Binding Users}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  md:DataGridAssist.CellPadding="4">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Login"  Binding="{Binding Login}"  Width="*"/>
                <DataGridTextColumn Header="Email"  Binding="{Binding Email}"  Width="2*"/>
                <DataGridTextColumn Header="Rola"   Binding="{Binding Role}"   Width="Auto"/>
                <DataGridTemplateColumn Header="Akcje" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="Rola"
                                        Command="{Binding DataContext.ChangeRoleCommand,
                                                          RelativeSource={RelativeSource AncestorType=Page}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource MaterialDesignFlatButton}"/>
                                <Button Content="Usuń"
                                        Margin="8 0 0 0"
                                        Command="{Binding DataContext.DeleteCommand,
                                                          RelativeSource={RelativeSource AncestorType=Page}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource MaterialDesignFlatButton}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- overlay "busy" -->
        <Border Background="#80000000"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Ładowanie..."
                       Foreground="White" FontSize="18"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Page>
