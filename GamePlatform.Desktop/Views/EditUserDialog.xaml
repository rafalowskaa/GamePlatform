<Window x:Class="GamePlatform.Desktop.Views.EditUserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:enums="clr-namespace:GamePlatform.Shared.Enums;assembly=GamePlatform.Shared"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Edytuj użytkownika"
        MinWidth="300"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Style="{StaticResource MaterialDesignWindow}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- login -->
            <RowDefinition Height="Auto"/>
            <!-- email -->
            <RowDefinition Height="Auto"/>
            <!-- rola -->
            <RowDefinition Height="Auto"/>
            <!-- blokada -->
            <RowDefinition Height="*"/>
            <!-- powód -->
            <RowDefinition Height="Auto"/>
            <!-- btn -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LOGIN (tylko podgląd) -->
        <TextBlock Text="Login:" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Text="{Binding Login}" Margin="8 0"/>

        <!-- EMAIL (edytowalne) -->
        <TextBlock Grid.Row="1" Text="E-mail:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0 6 0 0"/>
        <TextBox  Grid.Row="1" Grid.Column="1" Margin="8 6 0 0"
                  Text="{Binding Email}" />

        <!-- ROLA -->
        <TextBlock Grid.Row="2" Text="Rola:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0 6 0 0"/>
        <ComboBox Grid.Row="2" Grid.Column="1" Margin="8 6 0 0" Width="160"
                  ItemsSource="{x:Static enums:EnumExtensions.RoleValues}"
                  SelectedItem="{Binding Role}"/>

        <!-- BLOKADA -->
        <TextBlock Grid.Row="3" Text="Blokada do:" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <DatePicker Grid.Row="3" Grid.Column="1" Margin="8 0 0 0" Width="160"
                    SelectedDate="{Binding BlockedUntilUtc}"
                    DisplayDateStart="{x:Static sys:DateTime.Today}"/>

        <!-- POWÓD -->
        <TextBlock Grid.Row="4" Text="Powód:" FontWeight="SemiBold" VerticalAlignment="Top"/>
        <TextBox  Grid.Row="4" Grid.Column="1" Margin="8 0 0 0" Height="70"
                  AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                  Text="{Binding BlockReason}" md:HintAssist.Hint="Powód blokady"/>

        <!-- PRZYCISKI -->
        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0 16 0 0">
            <Button Content="Anuluj" Width="80" IsCancel="True"
                    Style="{StaticResource MaterialDesignFlatButton}"/>
            <Button Content="Zapisz" Width="80" Margin="12 0 0 0"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Command="{Binding SaveCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                    IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
