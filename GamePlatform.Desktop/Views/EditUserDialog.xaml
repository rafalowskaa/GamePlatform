<Window x:Class="GamePlatform.Desktop.Views.EditUserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:loc="clr-namespace:GamePlatform.Desktop.Localization"
        Title="{loc:Loc EDIT_USER}"
        Width="340"
        Height="340"
        SizeToContent="Manual"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Style="{StaticResource MaterialDesignWindow}">

    <!-- JEDYNY element podrzędny Window → Grid -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Login -->
            <RowDefinition Height="Auto"/>
            <!-- E-mail -->
            <RowDefinition Height="Auto"/>
            <!-- Rola -->
            <RowDefinition Height="Auto"/>
            <!-- Blokada -->
            <RowDefinition Height="*"/>
            <!-- Powód -->
            <RowDefinition Height="Auto"/>
            <!-- Przyciski -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LOGIN -->
        <TextBlock FontWeight="SemiBold" VerticalAlignment="Center">
            <Run Text="{loc:Loc LOGIN}"/><Run Text=":"/>
        </TextBlock>
        <TextBlock Grid.Column="1" Margin="8 0" Text="{Binding Login}" />

        <!-- E-MAIL -->
        <TextBlock Grid.Row="1" FontWeight="SemiBold"
                   VerticalAlignment="Center" Margin="0 6 0 0">
            <Run Text="{loc:Loc EMAIL}"/><Run Text=":"/>
        </TextBlock>
        <TextBox  Grid.Row="1" Grid.Column="1" Margin="8 6 0 0"
                  Text="{Binding Email}" />

        <!-- ROLA -->
        <TextBlock Grid.Row="2" FontWeight="SemiBold"
                   VerticalAlignment="Center" Margin="0 6 0 0">
            <Run Text="{loc:Loc ROLE}"/><Run Text=":"/>
        </TextBlock>
        <ComboBox Grid.Row="2" Grid.Column="1"
                  HorizontalAlignment="Stretch"
                  Margin="8 6 0 0"
                  MinWidth="160"
                  ItemsSource="{Binding Roles}"
                  SelectedItem="{Binding Role}" />

        <!-- BLOKADA + przycisk ✕ -->
        <TextBlock Grid.Row="3" FontWeight="SemiBold"
                   VerticalAlignment="Center">
            <Run Text="{loc:Loc BLOCK_UNTIL}"/><Run Text=":"/>
        </TextBlock>
        <DockPanel Grid.Row="3" Grid.Column="1" Margin="8 0 0 0">

            <DatePicker DockPanel.Dock="Left"
                SelectedDate="{Binding BlockedUntilUtc}"
                DisplayDateStart="{x:Static sys:DateTime.Today}"
                Width="160"/>

            <!--  PRZYCISK  ✕  – czarne tło + biały znak  -->
            <Button DockPanel.Dock="Right"
            Command="{Binding ClearBlockCommand}"
            Width="26" Height="26" Margin="4 0 0 0"
            Background="#111" Foreground="White" BorderBrush="#111"
            FontSize="14" Content="✕"
            Padding="0" FocusVisualStyle="{x:Null}"/>
        </DockPanel>

        <!-- POWÓD -->
        <TextBlock Grid.Row="4" FontWeight="SemiBold"
                   VerticalAlignment="Top" TextWrapping="Wrap">
            <Run Text="{loc:Loc REASON}"/><Run Text=":"/>
        </TextBlock>
        <TextBox  Grid.Row="4" Grid.Column="1" Margin="8 0 0 0" MinHeight="70" 
                  AcceptsReturn="True"
                  TextWrapping="WrapWithOverflow"                   
            VerticalScrollBarVisibility="Auto"
                  Text="{Binding BlockReason}"
                  md:HintAssist.Hint="{loc:Loc BLOCK_REASON}" />

            <!-- PRZYCISKI -->
            <StackPanel Grid.Row="5" Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0 16 0 0">
            <Button Content="{loc:Loc CANCEL}" Width="80" IsCancel="True"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Background="Black" Foreground="White" BorderBrush="Black" />
            <Button Content="{loc:Loc SAVE}" Width="80" Margin="12 0 0 0"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="Black" Foreground="White" BorderBrush="Black"
                    Command="{Binding SaveCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                    IsDefault="True" />
            </StackPanel>
    </Grid>
</Window>
