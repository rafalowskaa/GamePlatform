<Page x:Class="GamePlatform.Desktop.Views.FindFriendsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="Dodaj znajomego">

    <DockPanel Margin="24">

        <!-- pasek wyszukiwania -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
            <TextBox Width="260"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="OnKey"
                     md:HintAssist.Hint="Login lub e-mail"/>
            <Button Content="Szukaj"
                    Margin="8 0 0 0"
                    Command="{Binding SearchCommand}"/>
        </StackPanel>

        <!-- wyniki -->
        <ListBox ItemsSource="{Binding Results}"
                 Margin="0 12 0 0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Login}" Width="120"/>
                        <TextBlock Text="{Binding Email}" Width="200"/>
                        <Button Content="Zaproś"
                                Command="{Binding DataContext.InviteCommand,
                                                  RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Page>
