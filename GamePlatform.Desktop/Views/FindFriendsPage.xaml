<UserControl x:Class="GamePlatform.Desktop.Views.FindFriendsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:loc="clr-namespace:GamePlatform.Desktop.Localization">

    <DockPanel Margin="24">

        <!-- pasek wyszukiwania -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
            <TextBox Width="260"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="OnKey"
                     md:HintAssist.Hint="{loc:Loc LOGIN_OR_EMAIL}"/>
            <Button Content="{loc:Loc SEARCH}"
                    Margin="8 0 0 0"
                    Background="Black" Foreground="White" BorderBrush="Black"
                    Command="{Binding SearchCommand}"/>
        </StackPanel>

        <!-- wyniki -->
        <ListBox ItemsSource="{Binding Results}"
                 Margin="0 12 0 0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Login}" Width="120"/>
                        <TextBlock Text="{Binding Email}" Width="200"/>
                        <Button Content="{loc:Loc INVITE}" Background="Black" Foreground="White" BorderBrush="Black"
                                Command="{Binding DataContext.InviteCommand,
                                                  RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
