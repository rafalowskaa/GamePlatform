<Window x:Class="GamePlatform.Desktop.Views.ReportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:loc="clr-namespace:GamePlatform.Desktop.Localization"
        Title="Zgłoś użytkownika"
        Width="340"
        Height="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Style="{StaticResource MaterialDesignWindow}">

    <StackPanel Margin="24" Width="300">

        <!-- Etykieta + Combo -->
        <TextBlock Text="Kategoria:" Margin="0 0 0 4"
                   FontWeight="SemiBold"/>
        <ComboBox ItemsSource="{Binding Categories}"
                  SelectedItem="{Binding SelectedCategory}"
                  Style="{StaticResource MaterialDesignFilledComboBox}"
                  Margin="0 0 0 12"/>

        <!-- Etykieta + opis -->
        <TextBlock Text="Opis (obowiązkowy):"
                   Margin="0 0 0 4"
                   FontWeight="SemiBold"/>
        <TextBox Height="140"
                 AcceptsReturn="True"
                 Text="{Binding Description}"
                 TextWrapping="Wrap"
                 Style="{StaticResource MaterialDesignFilledTextBox}"/>

        <!-- PRZYCISKI -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0 16 0 0">
            <Button Content="{loc:Loc CANCEL}" IsCancel="True"
                    Background="Black" Foreground="White" BorderBrush="Black"/>
            <Button Content="{loc:Loc SEND}"
                    Width="80"
                    Margin="12 0 0 0"
                    Background="Black" Foreground="White" BorderBrush="Black"
                    Command="{Binding SubmitCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
