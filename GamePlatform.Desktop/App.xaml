<Application x:Class="GamePlatform.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:conv="clr-namespace:GamePlatform.Desktop.Converters"
             ShutdownMode="OnMainWindowClose">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>

                <!-- Twoje zasoby -->
                <ResourceDictionary Source="pack://application:,,,/Resources/MaterialColors.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Resources/IconPack.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Resources/Converters.xaml"/>

                <!-- Motyw -->
                <md:BundledTheme BaseTheme="Dark"
                                 PrimaryColor="Indigo"
                                 SecondaryColor="Lime"/>

                <!-- Style bazowe (Material Design 2) -->
                <ResourceDictionary
                    Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml"/>

            </ResourceDictionary.MergedDictionaries>

            <!-- Konwertery -->
            <conv:BoolToVisConverter x:Key="BoolToVis"/>
            <conv:ModeToVisConverter x:Key="ModeToVis"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
