<Application x:Class="GamePlatform.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             ShutdownMode="OnExplicitShutdown">

    <Application.Resources>
        <ResourceDictionary>

            <!-- konwerter widoczności -->
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <ResourceDictionary.MergedDictionaries>

                <!-- kolory własne -->
                <ResourceDictionary Source="pack://application:,,,/Resources/MaterialColors.xaml"/>

                <!-- ikony -->
                <ResourceDictionary Source="pack://application:,,,/Resources/IconPack.xaml"/>

                <!--  ⇓  NOWY SŁOWNIK ZE STYLAMI TEKSTU  ⇓  -->
                <ResourceDictionary Source="pack://application:,,,/Resources/TextStyles.xaml"/>

                <!-- motyw Material Design -->
                <md:BundledTheme BaseTheme="Dark"
                                 PrimaryColor="Indigo"
                                 SecondaryColor="Lime"/>

                <!-- domyślne style Material Design 2 -->
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml"/>

            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
