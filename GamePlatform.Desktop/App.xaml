<Application x:Class="GamePlatform.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:conv="clr-namespace:GamePlatform.Desktop.Converters"
             ShutdownMode="OnExplicitShutdown">

    <Application.Resources>
        <ResourceDictionary>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <conv:OnlineBrushConverter x:Key="OnlineBrush"/>
            <conv:FriendActionConverter x:Key="FriendAction"/>
            <conv:OnlineStatusTextConverter x:Key="OnlineStatusText"/>
            <conv:MessageBackgroundConverter x:Key="MsgBg"/>
            <conv:MessageSenderConverter x:Key="MsgSender"/>
            <conv:AvatarPathToImageConverter x:Key="AvatarConverter"/>
            <conv:BoolToBrushConverter x:Key="BoolToBrush"/>
            <conv:BoolToThicknessConverter x:Key="BoolToThickness"/>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" Invert="True"/>
            <conv:BoolToHAlignmentConverter x:Key="BoolToAlign"/>

            <!-- globalny Snackbar -->
            <md:SnackbarMessageQueue x:Key="GlobalMsgQueue" DiscardDuplicates="True"/>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Resources/MaterialColors.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Resources/IconPack.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Resources/TextStyles.xaml"/>

                <md:BundledTheme BaseTheme="Dark"
                                 PrimaryColor="Indigo"
                                 SecondaryColor="Lime"/>

                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
