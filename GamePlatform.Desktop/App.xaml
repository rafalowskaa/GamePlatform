<Application x:Class="GamePlatform.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:conv="clr-namespace:GamePlatform.Desktop.Converters"
             ShutdownMode="OnMainWindowClose">

	<Application.Resources>
		<ResourceDictionary>
			<!--  motyw  -->
			<ResourceDictionary.MergedDictionaries>
				<md:BundledTheme BaseTheme="Dark"
                                 PrimaryColor="Indigo"
                                 SecondaryColor="Lime" />

				<ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml" />
				<ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Dark.xaml" />
			</ResourceDictionary.MergedDictionaries>

			<!--  konwertery globalne  -->
			<conv:ModeToVisConverter x:Key="ModeToVis" />
			<conv:BoolToVisConverter x:Key="BoolToVis" />
		</ResourceDictionary>
	</Application.Resources>
</Application>